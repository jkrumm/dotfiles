<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>__LABEL__</string>
  <!-- The kiri trial's 48-hour reading (docs/kiri-trial.md, step 3): one line every 15 minutes of the
       VM's footprint, the mariadb copy's health and restarts. A copy of kiri-trial.sh in the install
       dir, so it survives a worktree. Written by kiri/kiri-setup.sh `up`, removed by `down`. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME_DIR__/kiri-trial.sh</string>
    <string>sample</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HOME__/.local/state/kiri-trial/mariadb-sample.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.local/state/kiri-trial/mariadb-sample.err</string>
</dict>
</plist>
