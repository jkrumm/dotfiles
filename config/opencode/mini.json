{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "agent-gateway": {
        "type": "local",
        "command": [
          "bun",
          "run",
          "{env:HOME}/SourceRoot/agent-gateway/server/mcp.ts"
        ],
        "timeout": {
          "execution": 1800000
        }
      }
    }
  }
}
