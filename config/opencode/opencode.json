{
  "$schema": "https://opencode.ai/config.json",
  "model": "iu/deepseek-v4.1-flash",
  "autoupdate": false,
  "share": "disabled",
  "permission": "allow",
  "instructions": [
    ".claude/rules/*.md",
    "~/.claude/rules/agent-limits.md",
    "~/.claude/rules/attribution.md",
    "~/.claude/rules/code-style.md",
    "~/.claude/rules/commit-conventions.md",
    "~/.claude/rules/dependency-hygiene.md",
    "~/.claude/rules/formatting.md",
    "~/.claude/rules/research-first.md",
    "~/.claude/rules/security.md",
    "~/.claude/rules/typescript.md"
  ],
  "mcp": {
    "servers": {
      "research-gateway": {
        "type": "remote",
        "url": "https://research.mini.jkrumm.com/mcp",
        "headers": {
          "Authorization": "{env:RESEARCH_GATEWAY_AUTH}"
        },
        "timeout": {
          "execution": 7200000
        },
        "oauth": false
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@1.10.1",
          "--isolated",
          "--headless",
          "--usageStatistics=false"
        ]
      }
    }
  },
  "agents": {
    "title": {
      "model": "iu-responses/gpt-6-luna"
    }
  },
  "providers": {
    "iu": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "IU unified endpoint (OpenAI route, Chat Completions)",
      "settings": {
        "baseURL": "{env:IU_OPENAI_BASE}",
        "apiKey": "{env:IU_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash",
          "limit": {
            "context": 850000,
            "output": 65536
          },
          "cost": {
            "input": 0.15,
            "output": 0.6,
            "cache": {
              "read": 0.003
            }
          },
          "settings": {
            "reasoningEffort": "high"
          },
          "variants": [
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            },
            {
              "id": "max",
              "settings": {
