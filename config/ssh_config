# --- op-only ---------------------------------------------------------------
# The two Mac hosts carry tailnet hostnames injected from 1Password, so these
# blocks are rendered only on the `op` backend (present human, biometric). On
# the cache backend (the mini) `_setup-ssh` deletes this whole region: the mini
# reaches neither Mac, and an unsubstituted placeholder hostname would be worse
# than an absent alias. The sentinel lines themselves are always stripped.
Host iumac
    HostName __IUMAC_HOSTNAME__
    User johannes.krumm

# Personal Mac mini (always-on home base — Hermes + Feuer live here). Reachable
# over Tailscale (tag:mac ACL). ForwardAgent lets the mini do git/ssh with
# approval popping on this machine's 1Password.
Host mini
    HostName __MINI_HOSTNAME__
    User jkrumm
    ForwardAgent yes
# --- end op-only -----------------------------------------------------------

# Infrastructure servers (HomeLab + VPS) — reached over Tailscale; MagicDNS
# resolves the short names on the tailnet. The Unix user is `jkrumm`; without
# this, ssh defaults to the local Mac login (johannes.krumm), which doesn't
# exist on the boxes and auth fails. Auth to these hosts is Tailscale SSH
# (keyless, tailnet-gated, works headless) — no key or 1Password agent involved.
Host homelab
    HostName homelab
    User jkrumm

Host vps
    HostName vps
    User jkrumm
