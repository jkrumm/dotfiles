# Every host here is a MagicDNS short name on the tailnet — that is the whole
# point of naming the machines `mini` / `iumac` / `homelab` / `vps`. No hostname
# is injected from 1Password any more: MagicDNS resolves the short name, so the
# tailnet FQDN never has to enter git or a secrets store to make ssh work, and
# this file renders identically on a headless machine with no `op` available.
#
# If a short name ever fails to resolve (a client whose DNS does not honour the
# tailnet search domain), ssh the full MagicDNS FQDN directly — the fix belongs
# in that machine's DNS config, not here.

# Applies to every host below.
#
# ServerAlive*: without these a session on a flaky link hangs forever instead of
# failing fast — 15s probes, dead after 3 misses (~45s). Note this only helps the
# ssh path; mosh has its own UDP heartbeat and ignores all of it.
#
# SetEnv TERM: cmux runs on libghostty and exports TERM=xterm-ghostty. Sent to a
# host without that terminfo entry it produces doubled keystrokes
# (manaflow-ai/cmux#2969). Pin a universally-present value rather than install
# ghostty terminfo on every box.
Host *
    ServerAliveInterval 15
    ServerAliveCountMax 3
    TCPKeepAlive yes
    SetEnv TERM=xterm-256color

# Personal Mac mini (always-on home base — Hermes + Feuer live here). Reached
# over Tailscale (tag:mac ACL) with OpenSSH, not Tailscale SSH: remote dev needs
# agent forwarding, ControlMaster and full-speed transfer. ForwardAgent lets the
# mini do git/ssh with approval popping on the connecting machine's 1Password.
Host mini
    HostName mini
    User jkrumm
    ForwardAgent yes
    # ControlMaster — this comment claimed it for a long time without it being
    # set. It matters now: herdr/cmux open several connections, and without
    # multiplexing each one repeats a full handshake *and* a separate 1Password
    # biometric approval. One shared connection, held 10m after the last exit.
    # Socket dir is created by `make setup` (_setup-ssh).
    ControlMaster auto
    ControlPath ~/.ssh/cm/%r@%h:%p
    ControlPersist 10m

# The IU work laptop. Reverse of `Host mini`: the mini dials OUT to the
# MacBook for rsync/scp pulls, usage-tracker stats, brain/dotfiles sync — auth
# is the dedicated mini->iumac key (config/ssh/authorized_keys), not the 1P
# agent, because macOS ships no Tailscale SSH server for this leg.
#
# IdentityAgent none is NOT optional on the mini: SSH_AUTH_SOCK there still
# points at the 1Password agent socket, and any target that consults it hangs
# forever rather than failing (dotfiles-private/docs/access-model.md).
# Pinning the agent off makes this path headless-safe. IdentitiesOnly yes so
# only this key is ever offered. This file installs byte-identically on every
# machine (no rendering), so the block is harmless on the MacBook itself —
# `ssh iumac` there is a self-loop nobody uses, and IdentityFile simply won't
# exist. ControlMaster for the same reason as `Host mini`: repeated handshakes
# on rsync/git loops.
#
# Prerequisite: this only resolves once the device is renamed to `iumac`
# (dotfiles-private/docs/macbook-todo.md item 4.1) — it still carries its
# original Tailscale device name today.
Host iumac
    HostName iumac
    User johannes.krumm
    IdentityFile ~/.ssh/id_ed25519_iumac
    IdentitiesOnly yes
    IdentityAgent none
    ControlMaster auto
    ControlPath ~/.ssh/cm/%r@%h:%p
    ControlPersist 10m

# Infrastructure servers (HomeLab + VPS). The Unix user is `jkrumm`; without
# this, ssh defaults to the local Mac login (johannes.krumm), which doesn't
# exist on the boxes and auth fails. Auth to these hosts is Tailscale SSH
# (keyless, tailnet-gated, works headless) — no key or 1Password agent involved.
Host homelab
    HostName homelab
    User jkrumm

Host vps
    HostName vps
    User jkrumm
