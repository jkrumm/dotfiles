modelpick.test {
	import local
	reverse_proxy localhost:7727
}

# jkrumm.com — personal portfolio homepage (Astro 7 static, motion reveals) on
# :7728. Hard-assigned port; the dev script runs `bunx kill-port 7728` first and
# astro.config sets strictPort so a clash fails loudly instead of drifting.
jkrumm.test {
	import local
	reverse_proxy localhost:7728
}

# rb — personal learning tracker. Always-on Docker stack on the mini: one
# container on :4050 (Elysia serving both the API and the built SPA), published
# to 127.0.0.1 only. Primary access is `tailscale serve` on the host (real
# *.ts.net LE cert, reachable from every device) and its row points at 4050 —
# rb.test is just the local convenience door.
#
# This block said 7730 until 2026-07-31, which was the port of a separate Vite
# web container that no longer exists. Nothing has bound 7730 since, so the
# local door 502'd and the tailnet status column reported rb red permanently
# while rb was in fact up and serving. 7730 survives as the OUTSIDE port of the
# serve row (`:7730 → 127.0.0.1:4050`), which is where the number comes from and
# why the stale value looked plausible.
rb.test {
	import local
	reverse_proxy localhost:4050
}

# linewatch — uptime + throughput history for this internet line
# (~/SourceRoot/linewatch). One container serving both the API and the built
# dashboard; the ping collector runs natively under launchd beside it, because
# Colima's NAT fabricates ICMP replies inside a container.
# Deliberately clean-door only — a port door would make Caddy bind 7731 on
# the tailnet interface, and the container already publishes it on loopback.
linewatch.test {
	import local
	reverse_proxy localhost:7731
}

# brain — the Obsidian vault reader (basalt-ui-obsidian demo app). Reads
# ~/SourceRoot/brain at build time and serves it as an offline-first PWA.
# Tailnet-only by design: the vault carries private health data and there is
# deliberately no auth layer, so the tailnet ACL is the whole perimeter. The
# mini's automatic `brain.mini.jkrumm.com` door is how the iPhone reaches it.
# Port 7733, not 7732: 7732 is already claimed by linewatch/web's Vite dev
# script (`npx kill-port 7732 && vite --port 7732 --strictPort`) — a genuine
# double-booking caught 2026-08-08. 7733 is free and inside the tailnet ACL's
# tcp:7700-7799 grant.
brain.test {
	import local
	reverse_proxy localhost:7733
}

# hermes-web — the Hermes Agent browser UI (~/SourceRoot/hermes-webui, a
# LaunchAgent on loopback :8789). Deployment lives in hermes-agent; this block
# only gives it a name.
#
# It ALSO has a `tailscale serve` row (:8789, tailnet-only, tag:phone) and both
# doors stay. The serve row is the zero-dependency one — tailscaled mints its own
# cert, so it survives a Cloudflare outage, an expired DNS token, or a Caddy that
# will not start, and that is the door the phone is configured against. This block
# is what makes the UI reachable from the MacBook: the serve row's ACL grant is
# `tag:phone → tag:mac` alone, and both Macs are tag:mac, so widening it would have
# handed the work MacBook a UI that reads every Hermes session and memory. The
# clean door is already scoped to the additive tag:devhost (the mini alone), which
# is exactly the distinction that grant could not express.
#
# No port door: binding 8789 on the tailnet interface would collide head-on
# with the serve row above.
hermes-web.test {
	import local
	reverse_proxy localhost:8789
}

# hermes-api — `hermes serve` (loopback :9119), the JSON-RPC/WebSocket backend
# Hermes Desktop connects to. Distinct from hermes-web above: that is a
# third-party browser UI, this is upstream's own Desktop backend, and upstream
# expects both it and the Slack gateway to run.
#
# The WebSocket at /api/ws is why this door works at all — Caddy's reverse_proxy
# upgrades natively, so no extra directive is needed. It is also why the :8642
# OpenAI-compatible API cannot substitute: that server has no /api/ws route.
#
# Auth is the backend's, not Caddy's. config.yaml sets dashboard.public_url to
# this hostname precisely so Hermes engages its own auth gate despite the loopback
# bind — upstream turns auth on for a non-loopback bind OR an operator-declared
# external URL, and "reverse proxy in front of loopback" is what that second
# clause is for. Do not add `import local` style basic_auth here on top; two auth
# layers would break Desktop's /api/status discovery handshake.
#
# 9119 stays loopback-only, which is the whole access-control argument — a
# tailnet bind could only be scoped to tag:mac, i.e. both Macs including the
# work laptop, while this door is scoped to tag:devhost (the mini).
hermes-api.test {
	import local
	reverse_proxy localhost:9119
}

# meteo — self-hosted weather platform on the mini (point/marine API + tile service)
meteo.test {
	import local
	reverse_proxy localhost:8080
}
meteo-tiles.test {
	import local
	reverse_proxy localhost:8081
}
# The live map. Same origin as the tile service on purpose — /layers, /tiles and
# /probe are fetched with origin-relative URLs, so there is no CORS surface at all.
meteo-map.test {
	import local
	redir / /map/ 302
	reverse_proxy localhost:8081
}

# ─── VPN-only AWS web UIs (via prometheus-scripts/vpn sidecar) ───────────────
# Caddy fronts the public hostname on 127.0.0.1:443; the sidecar binds a
# non-443 port and forwards over the AWS Client VPN tunnel. /etc/hosts pin
# (managed by `make vpn-web-install` in ~/IuRoot/prometheus-scripts/vpn)
# routes the hostname to 127.0.0.1 so Caddy gets the request first.
# Browser sees Caddy's local-CA cert; Caddy verifies the real upstream cert.

metabase.iu-aws.de {
	bind 127.0.0.1
	tls internal
	reverse_proxy https://127.0.0.1:24443 {
		header_up Host metabase.iu-aws.de
		transport http {
			tls
			tls_server_name metabase.iu-aws.de
		}
	}
}
