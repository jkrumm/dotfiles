# audio — agent-workflows' audio process (com.jkrumm.agent-workflows-audio, :7792, loopback): the
# OpenAI-compatible STT/TTS door, bearer-gated per caller (MacWhisper on the MacBook transcribes
# through it). Only the door paths are forwarded — /v1/audio/* and /audio/*, the matcher in
# agent-workflows' packages/audio/src/process/door.ts; /health and /api/* on the same port are 404 here.
# scripts/lib/caddy-registry.py carries the path restriction into the generated tailnet door.
audio.test {
	import local
	@door path /v1/audio/* /audio/*
	handle @door {
		reverse_proxy localhost:7792
	}
	handle {
		respond 404
	}
}

# agw-image — agent-workflows' host (:7791, loopback): the image door, bearer-gated per caller (the
# studio app on the MacBook generates, edits and enhances images through it). Only the door paths are
# forwarded — /door/image/*, the routes in agent-workflows' host; /health, /workflows/* and every API
# path on the same port are 404 here. scripts/lib/caddy-registry.py carries the path restriction into
# the generated tailnet door.
agw-image.test {
	import local
	@door path /door/image/*
	handle @door {
		reverse_proxy localhost:7791
	}
	handle {
		respond 404
	}
}

# iris — voice-memo server (Bun + Elysia), native LaunchAgent on the mini
# (com.jkrumm.iris, :7730, bound to 127.0.0.1). `iris.mini.jkrumm.com` is how the phone and the
# Mac reach it. /v1/events (SSE) and /v1/memos/:id/result?wait= (long poll) hold a response open
# for minutes — reverse_proxy has no read timeout by default, so nothing here may add one.
iris.test {
	import local
	reverse_proxy localhost:7730
}

# free-planning-poker — web (Next.js), server (Bun WS), analytics (FastAPI),
# logdy UI. Ports 7723-7726 reserved; 7724-7726 are logdy ingest sockets and
# don't need .test hosts. Caddy auto-handles WebSocket upgrades for fpp-server.
#
# fpp.test rewrites Host → localhost:7720 because Next.js dev server checks
# the Host header on dev-only endpoints (/__nextjs_original-stack-frames,
# _next/webpack-hmr); a foreign host returns 403 / drops the WS upgrade.
fpp.test {
	import local
	reverse_proxy localhost:7720 {
		header_up Host localhost:7720
	}
}
fpp-server.test {
	import local
	reverse_proxy localhost:7721
}
fpp-analytics.test {
	import local
	reverse_proxy localhost:7722
}
fpp-logdy.test {
	import local
	reverse_proxy localhost:7723
}

