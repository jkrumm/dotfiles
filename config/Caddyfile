# basalt-ui marketing site (apps/marketing, Astro) on :7711. Moved off 7710,
# which it shared with the playground below — both `dev` scripts hard-coded
# 7710, so whichever started second killed the first (`npx kill-port 7710`
# literally does that). 7711 rather than the 7714 freed by dropping the
# audio-gateway door below: dropping a Caddy block does not release a port, and
# audio-gateway's own `dev` script still claims 7714. Adjacent to its sibling,
# so the pair reads as a pair.
basalt.test {
	import local
	reverse_proxy localhost:7711
}

# basalt-ui — in-monorepo Mantine-pivot playground (apps/playground, @basalt-ui/playground)
basalt-playground.test {
	import local
	reverse_proxy localhost:7710
}

# argo — dashboard on :7715, Vite proxies /api internally to localhost:4040
argo.test {
	import local
	reverse_proxy localhost:7715
}

# audio-gateway.test — DROPPED 2026-07-30. The real gateway is the VPS
# container reached over the tailnet, so local clients (MacWhisper) point
# straight at https://audio-gateway.jkrumm.com/v1 and the local door bought
# nothing. The repo's `dev` script still binds :7714 for actual local work on
# the gateway — the port is NOT free, it just has no vhost in front of it.

# image-gen — stateless image-generation gateway (Elysia + Bun) on :7716.
# Local dev for the image-gen monorepo (`bun run dev` at its root also starts the
# Tauri app; Vite on :1420 is Tauri-internal, not proxied). VPS container reached
# over the tailnet at image.<domain>.
image-gen.test {
	import local
	reverse_proxy localhost:7716
}

# photo-flow — control panel (FastAPI serves the built SPA + API + SSE).
# Always-on via LaunchAgent on :7717; Vite dev server is :7718 (proxies to :7717).
# Caddy streams SSE (/events/*) fine by default — no special flush config needed.
#
# MacBook-only: the repo and its LaunchAgent live there, and nothing on the mini
# has ever bound 7717. The block stays here because both machines share this
# file; the mini carries `exclude photoflow` in ~/.config/caddy-tailnet.ports so
# it gets no tailnet door and stops reporting red for an app it does not run.
photoflow.test {
	import local
	reverse_proxy localhost:7717
}

# free-planning-poker — web (Next.js), server (Bun WS), analytics (FastAPI),
# logdy UI. Ports 7723-7726 reserved; 7724-7726 are logdy ingest sockets and
# don't need .test hosts. Caddy auto-handles WebSocket upgrades for fpp-server.
#
# fpp.test rewrites Host → localhost:7720 because Next.js dev server checks
# the Host header on dev-only endpoints (/__nextjs_original-stack-frames,
# _next/webpack-hmr); a foreign host returns 403 / drops the WS upgrade.
fpp.test {
	import local
	reverse_proxy localhost:7720 {
		header_up Host localhost:7720
	}
}
fpp-server.test {
	import local
	reverse_proxy localhost:7721
}
fpp-analytics.test {
	import local
	reverse_proxy localhost:7722
}
fpp-logdy.test {
	import local
	reverse_proxy localhost:7723
}

# modelpick — model-choice decider/dashboard (TanStack Start, SSR) on :7727.
modelpick.test {
	import local
	reverse_proxy localhost:7727
}

# jkrumm.com — personal portfolio homepage (Astro 7 static, motion reveals) on
# :7728. Hard-assigned port; the dev script runs `bunx kill-port 7728` first and
# astro.config sets strictPort so a clash fails loudly instead of drifting.
jkrumm.test {
	import local
	reverse_proxy localhost:7728
}

# rb — personal learning tracker. Always-on Docker stack on the mini: one
# container on :4050 (Elysia serving both the API and the built SPA), published
# to 127.0.0.1 only. Primary access is `tailscale serve` on the host (real
# *.ts.net LE cert, reachable from every device) and its row points at 4050 —
# rb.test is just the local convenience door.
#
# This block said 7730 until 2026-07-31, which was the port of a separate Vite
# web container that no longer exists. Nothing has bound 7730 since, so the
# local door 502'd and the tailnet status column reported rb red permanently
# while rb was in fact up and serving. 7730 survives as the OUTSIDE port of the
# serve row (`:7730 → 127.0.0.1:4050`), which is where the number comes from and
# why the stale value looked plausible.
rb.test {
	import local
	reverse_proxy localhost:4050
}

# linewatch — uptime + throughput history for this internet line
# (~/SourceRoot/linewatch). One container serving both the API and the built
# dashboard; the ping collector runs natively under launchd beside it, because
# Colima's NAT fabricates ICMP replies inside a container.
# Deliberately clean-door only, no `portdoor`: a port door would make Caddy bind
# 7731 on the tailnet interface, and the container already publishes it on
# loopback.
linewatch.test {
	import local
	reverse_proxy localhost:7731
}

