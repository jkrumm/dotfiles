# audio-gateway — consolidated OpenAI-compatible audio service (STT + expressive
# Gemini TTS) on :7714. Single source of truth for audio; VPS container reached
# over the tailnet at audio-gateway.jkrumm.com; local dev on :7714.
# Point local clients at https://audio-gateway.test/v1.
audio-gateway.test {
	import local
	reverse_proxy localhost:7714
}

# photo-flow — control panel (FastAPI serves the built SPA + API + SSE).
# Always-on via LaunchAgent on :7717; Vite dev server is :7718 (proxies to :7717).
# Caddy streams SSE (/events/*) fine by default — no special flush config needed.
photoflow.test {
	import local
	reverse_proxy localhost:7717
}

# free-planning-poker — web (Next.js), server (Bun WS), analytics (FastAPI),
# logdy UI. Ports 7723-7726 reserved; 7724-7726 are logdy ingest sockets and
# don't need .test hosts. Caddy auto-handles WebSocket upgrades for fpp-server.
#
# fpp.test rewrites Host → localhost:7720 because Next.js dev server checks
# the Host header on dev-only endpoints (/__nextjs_original-stack-frames,
# _next/webpack-hmr); a foreign host returns 403 / drops the WS upgrade.
fpp.test {
	import local
	reverse_proxy localhost:7720 {
		header_up Host localhost:7720
	}
}
fpp-server.test {
	import local
	reverse_proxy localhost:7721
}
fpp-analytics.test {
	import local
	reverse_proxy localhost:7722
}
fpp-logdy.test {
	import local
	reverse_proxy localhost:7723
}

# modelpick — model-choice decider/dashboard (TanStack Start, SSR) on :7727.
modelpick.test {
	import local
	reverse_proxy localhost:7727
}

# jkrumm.com — personal portfolio homepage (Astro 7 static, motion reveals) on
# :7728. Hard-assigned port; the dev script runs `bunx kill-port 7728` first and
# astro.config sets strictPort so a clash fails loudly instead of drifting.
jkrumm.test {
	import local
	reverse_proxy localhost:7728
}

