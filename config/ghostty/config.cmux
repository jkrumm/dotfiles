# cmux / Ghostty config — tuned for Warp-like feel
# Reload: Cmd+Shift+, inside cmux (or restart)

# ── Themes (Zinc Dark / Zinc Light) ──────────────────────────────────────────
# Neutral Tailwind-zinc grays for PANE CONTENT. herdr paints its own chrome from
# one-dark/one-light instead — the two are deliberately NOT the same palette.
#
# That is load-bearing, not laziness: herdr's one-dark leaves the sidebar
# transparent and marks the focused row by painting #282C34, so the row is only
# visible when the terminal behind it is darker. zinc-dark's #09090b gives 1.42;
# setting this to One Dark's own #282c34 would give 1.00 and hide the highlight
# completely. Full measurements in config/herdr/config.toml → [theme].
#
# Ghostty theme names are EXACT FILENAMES. These resolve because the files are
# literally named zinc-dark / zinc-light; bundled themes with spaces and capitals
# must be written that way ("Catppuccin Mocha", not catppuccin-mocha).
#
# The Blueprint v6 pair is still tracked as basalt-ui-{dark,light} if you want
# it back — but check the separation number above before swapping.
theme = dark:zinc-dark,light:zinc-light

# ── Font ─────────────────────────────────────────────────────────────────────
# Nerd Font variant: herdr's sidebar state icons and starship's prompt glyphs
# are Nerd Font codepoints and render as tofu without it. "Mono" (not "Propo")
# is deliberate — it forces single-width glyphs, so icons can't push herdr's
# column-aligned sidebar rows out of alignment.
font-family = JetBrainsMono Nerd Font Mono
font-size = 16

# ── Cursor — Warp default is solid block, no blink ───────────────────────────
cursor-style = block
cursor-style-blink = false

# ── Padding — Warp has subtle inset ──────────────────────────────────────────
window-padding-x = 10
window-padding-y = 6

# ── Scrollback — Warp is effectively unlimited ───────────────────────────────
scrollback-limit = 100000

# ── Window chrome ─────────────────────────────────────────────────────────────
window-decoration = auto
background-opacity = 1.0

# ── Behaviour ─────────────────────────────────────────────────────────────────
mouse-hide-while-typing = true
copy-on-select = false

# ── Splits (unfocused slightly dimmed, like Warp) ────────────────────────────
unfocused-split-opacity = 0.92
