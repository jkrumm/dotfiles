# cmux / Ghostty config — tuned for Warp-like feel
# Reload: Cmd+Shift+, inside cmux (or restart)

# ── Themes (Catppuccin Mocha / Latte) ────────────────────────────────────────
# Ghostty's OWN bundled themes — nothing hand-authored to maintain. Paired with
# herdr's built-in catppuccin/catppuccin-latte (config/herdr/config.toml), which
# is the only theme whose sidebar highlight survives the pairing; the reasoning
# and the measurements are in that file's [theme] block.
#
# NAMES ARE EXACT FILENAMES — case and spaces included. `catppuccin-mocha` does
# NOT resolve ("theme not found", then a silent fall back to no theme at all);
# only "Catppuccin Mocha" does. Verified with `ghostty +validate-config`.
#
# The Blueprint v6 pair is still tracked as basalt-ui-{dark,light} if you want
# it back — swap the names here and the two in herdr's [theme] block together.
theme = dark:Catppuccin Mocha,light:Catppuccin Latte

# ── Font ─────────────────────────────────────────────────────────────────────
# Nerd Font variant: herdr's sidebar state icons and starship's prompt glyphs
# are Nerd Font codepoints and render as tofu without it. "Mono" (not "Propo")
# is deliberate — it forces single-width glyphs, so icons can't push herdr's
# column-aligned sidebar rows out of alignment.
font-family = JetBrainsMono Nerd Font Mono
font-size = 16

# ── Cursor — Warp default is solid block, no blink ───────────────────────────
cursor-style = block
cursor-style-blink = false

# ── Padding — Warp has subtle inset ──────────────────────────────────────────
window-padding-x = 10
window-padding-y = 6

# ── Scrollback — Warp is effectively unlimited ───────────────────────────────
scrollback-limit = 100000

# ── Window chrome ─────────────────────────────────────────────────────────────
window-decoration = auto
background-opacity = 1.0

# ── Behaviour ─────────────────────────────────────────────────────────────────
mouse-hide-while-typing = true
copy-on-select = false

# ── Splits (unfocused slightly dimmed, like Warp) ────────────────────────────
unfocused-split-opacity = 0.92
