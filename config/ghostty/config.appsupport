# Shared terminal config — read by BOTH cmux and bare Ghostty.
# Installed to ~/Library/Application Support/com.mitchellh.ghostty/config.
# Reload: Cmd+Shift+, inside cmux (or restart the app).
#
# That path is Ghostty's OWN macOS config location (note the bundle id — cmux's
# is com.cmuxterm.app); cmux is built on Ghostty and reuses it. So this file is
# not cmux-specific, which is why it is no longer called config.cmux.
#
# Precedence, measured on Ghostty 1.3.1 and cmux's bundled 1.3.2 rather than
# assumed — both binaries agree:
#
#   ~/.config/ghostty/config      loaded first   (config/ghostty/config)
#   …/com.mitchellh.ghostty/config loaded second → WINS on conflicting keys
#
# The two are MERGED, not replaced: keys unique to either file all survive. Put
# anything that must win here; the sibling holds shell integration and the
# option-key behaviour. Both apps therefore render the same One Zinc look with no
# per-app configuration.

# ── Themes (One Zinc Dark / One Zinc Light) ──────────────────────────────────
# Muted Atom One hues on basalt-ui zinc surfaces, for PANE CONTENT. herdr paints
# its own chrome from its built-in one-dark/one-light — same hue family, so the
# two agree without having to be the same file.
#
# The backgrounds are middle-ground on purpose: #1f1f23 dark (between basalt's
# zinc-900 and zinc-800), #f2f2f5 light (basalt's own --vx-surface-bg). Never
# black, never white. herdr's focused sidebar row lands on these at 1.17 / 1.03
# separation, which is subtle by design — it also renders that row bold and in a
# brighter fg, so the background is not the only cue. Full reasoning and the pty
# measurements behind it are in each theme file's header.
#
# Ghostty theme names are EXACT FILENAMES. These resolve because the files are
# literally named one-zinc-dark / one-zinc-light; bundled themes with spaces and
# capitals must be written that way ("Catppuccin Mocha", not catppuccin-mocha).
#
# The Blueprint v6 pair is still tracked as basalt-ui-{dark,light} if you want it
# back.
theme = dark:one-zinc-dark,light:one-zinc-light

# ── Font ─────────────────────────────────────────────────────────────────────
# Nerd Font variant: herdr's sidebar state icons and starship's prompt glyphs
# are Nerd Font codepoints and render as tofu without it. "Mono" (not "Propo")
# is deliberate — it forces single-width glyphs, so icons can't push herdr's
# column-aligned sidebar rows out of alignment.
font-family = JetBrainsMono Nerd Font Mono
font-size = 16

# ── Cursor — Warp default is solid block, no blink ───────────────────────────
cursor-style = block
cursor-style-blink = false

# ── Padding — Warp has subtle inset ──────────────────────────────────────────
window-padding-x = 10
window-padding-y = 6

# ── Scrollback — Warp is effectively unlimited ───────────────────────────────
scrollback-limit = 100000

# ── Window chrome ─────────────────────────────────────────────────────────────
window-decoration = auto
background-opacity = 1.0

# ── Behaviour ─────────────────────────────────────────────────────────────────
mouse-hide-while-typing = true
copy-on-select = false

# ── Splits (unfocused slightly dimmed, like Warp) ────────────────────────────
unfocused-split-opacity = 0.92
