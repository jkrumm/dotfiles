# One Light — matches herdr's built-in `one-light` theme.
#
# Normals are the canonical Atom One Light hues. Upstream "One Half Light"
# fills slots 9-14 with the *dark* theme's pastels, which wash out badly on a
# #fafafa background. Here bright means deeper and more saturated rather than
# lighter — the convention that actually reads as emphasis on a light surface.
# Where Atom One Light publishes a second shade of a hue (hue-5-2 dark red,
# hue-6 dark orange, hue-2 vivid blue) that value is used directly.
background = #fafafa
foreground = #383a42
cursor-color = #4078f2
cursor-text = #fafafa
selection-background = #dbdbdc
selection-foreground = #383a42

# Normal colors (0-7) — canonical Atom One Light
palette = 0=#383a42
palette = 1=#e45649
palette = 2=#50a14f
palette = 3=#c18401
palette = 4=#0184bc
palette = 5=#a626a4
palette = 6=#0997b3
palette = 7=#a0a1a7

# Bright colors (8-15) — deeper, not lighter
palette = 8=#4f525e
palette = 9=#ca1243
palette = 10=#3c8a3b
palette = 11=#986801
palette = 12=#4078f2
palette = 13=#8b1f89
palette = 14=#077d94
palette = 15=#ffffff
