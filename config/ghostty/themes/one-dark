# One Dark — matches herdr's built-in `one-dark` theme.
#
# Normals are the canonical Atom One Dark hues (hue-1..hue-6). Upstream
# "One Half Dark" repeats those hues verbatim in slots 9-14, so bold/bright
# text renders identically to normal text — a real defect in a terminal, where
# ls/grep/diff lean on bright. Slots 9-14 here are the published One Dark Two
# lift of the same hues, so bright stays recognisably the same color, just
# brighter. Black is One Dark's mono-3 rather than the background, which would
# otherwise make palette 0 invisible.
background = #282c34
foreground = #abb2bf
cursor-color = #61afef
cursor-text = #282c34
selection-background = #3e4451
selection-foreground = #dcdfe4

# Normal colors (0-7) — canonical Atom One Dark
palette = 0=#3f4451
palette = 1=#e06c75
palette = 2=#98c379
palette = 3=#e5c07b
palette = 4=#61afef
palette = 5=#c678dd
palette = 6=#56b6c2
palette = 7=#dcdfe4

# Bright colors (8-15) — same hues lifted for emphasis
palette = 8=#5c6370
palette = 9=#e68991
palette = 10=#a8cc8e
palette = 11=#edcf97
palette = 12=#8dc7f6
palette = 13=#d3a2e2
palette = 14=#78c4ce
palette = 15=#e6e6e6
