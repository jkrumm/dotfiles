# Zinc Light — neutral grays, no color cast in the chrome.
#
# Sibling of zinc-dark; grays are Tailwind zinc (50/400/600/800).
#
# Unlike the dark member, this one has no background constraint from herdr:
# herdr's `one-light` paints its OWN sidebar (#F5F5F6) distinct from its active
# row (#FAFAFA), so the highlight works regardless of what the terminal is doing.
# That asymmetry is real and measured — only one-dark leaves the sidebar
# transparent and depends on the terminal being darker.
#
# Bright means DEEPER here, not lighter — the convention that reads as emphasis
# on a light surface. Upstream themes that copy the dark member's pastels into
# slots 9-14 wash out completely on #fafafa.
#
# Every accent measured >= 4.5 contrast on #fafafa except palette 7, which is a
# light gray by definition and is used for dim fills rather than text.
background = #fafafa
foreground = #27272a
cursor-color = #296aa3
cursor-text = #fafafa
selection-background = #e4e4e7
selection-foreground = #27272a

# Normal colors (0-7) — muted accents on a zinc ramp
palette = 0=#27272a
palette = 1=#ab5959
palette = 2=#1e754f
palette = 3=#a65e2b
palette = 4=#296aa3
palette = 5=#8f4d78
palette = 6=#20707d
palette = 7=#a1a1aa

# Bright colors (8-15) — deeper, not lighter
palette = 8=#52525b
palette = 9=#8f4444
palette = 10=#145c3d
palette = 11=#85491f
palette = 12=#1d5382
palette = 13=#733c60
palette = 14=#185963
palette = 15=#ffffff
