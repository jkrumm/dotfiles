# Shell integration — enables semantic zones (command blocks) in Ghostty
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# Required for Option+Left/Right word-jumping to work
# "left" means only the left Option key acts as Alt; right Option still types special chars
macos-option-as-alt = left

# Auto-switch the One Zinc pair with macOS appearance.
# Kept in sync with config.cmux (the file cmux actually reads). herdr runs its
# built-in one-dark/one-light for its own chrome — see config/herdr/config.toml.
theme = light:one-zinc-light,dark:one-zinc-dark
