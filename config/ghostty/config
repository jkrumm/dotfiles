# Ghostty terminal config — read from ~/.config/ghostty/config, Ghostty's own
# config path. Reload: restart the app (or Ghostty's reload-config keybind).

# Shell integration — enables semantic zones (command blocks) in Ghostty
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# Required for Option+Left/Right word-jumping to work
# "left" means only the left Option key acts as Alt; right Option still types special chars
macos-option-as-alt = left

# ── Themes (One Zinc Dark / One Zinc Light) ──────────────────────────────────
# Muted Atom One hues on basalt-ui zinc surfaces, for PANE CONTENT. The Herdr app paints
# its chrome from its own one-zinc-{light,dark} themes (config/herdr-app/themes/, basalt-ui
# tokens), so terminal and chrome agree without being the same file.
#
# The backgrounds are middle-ground on purpose: #1f1f23 dark (between basalt's
# zinc-900 and zinc-800), #f2f2f5 light (basalt's own --vx-surface-bg). Never
# black, never white. The theme file headers keep the contrast measurements taken
# against classic herdr's sidebar (history, retiring with it).
theme = dark:one-zinc-dark,light:one-zinc-light

# ── Font ─────────────────────────────────────────────────────────────────────
# Nerd Font variant: starship's prompt glyphs and the Herdr app's status icons are
# Nerd Font codepoints and render as tofu without it. "Mono" (not "Propo") forces
# single-width glyphs, so icons can't push column-aligned rows out of alignment.
font-family = JetBrainsMono Nerd Font Mono
font-size = 16

# ── Cursor — Warp default is solid block, no blink ───────────────────────────
cursor-style = block
cursor-style-blink = false

# ── Padding — Warp has subtle inset ──────────────────────────────────────────
window-padding-x = 10
window-padding-y = 6

# ── Scrollback — Warp is effectively unlimited ───────────────────────────────
scrollback-limit = 100000

# ── Window chrome ─────────────────────────────────────────────────────────────
window-decoration = auto
background-opacity = 1.0

# ── Behaviour ─────────────────────────────────────────────────────────────────
mouse-hide-while-typing = true
copy-on-select = false

# ── Splits (unfocused slightly dimmed, like Warp) ────────────────────────────
unfocused-split-opacity = 0.92
