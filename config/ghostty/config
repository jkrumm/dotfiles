# Shell integration — enables semantic zones (command blocks) in Ghostty
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# Required for Option+Left/Right word-jumping to work
# "left" means only the left Option key acts as Alt; right Option still types special chars
macos-option-as-alt = left

# Auto-switch between the neutral zinc pair with macOS appearance.
# Kept in sync with config.cmux (the file cmux actually reads). herdr runs
# one-dark/one-light instead — see config/herdr/config.toml for why the terminal
# and herdr deliberately do NOT share a palette.
theme = light:zinc-light,dark:zinc-dark
