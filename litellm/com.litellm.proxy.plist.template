<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.litellm.proxy</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/SourceRoot/dotfiles/litellm/bin/start-litellm.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key><string>__HOME__</string>
  </dict>
  <key>WorkingDirectory</key><string>__HOME__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- ~/Library/Logs, not /tmp. macOS's periodic cleanup sweeps /tmp files
       untouched for 3+ days, and a KeepAlive agent opens its stdio ONCE at
       spawn — so after a sweep it writes into an UNLINKED inode forever.
       Measured on the mini 2026-07-31: `lsof -p 884` held
       /private/tmp/litellm.{log,err} open while `ls` found neither. litellm had
       no post-mortem at all. Same pattern devhost-health and
       linewatch-collector already use. WorkingDirectory moved off /tmp for the
       same reason — a swept cwd is an unlinked directory the process cannot
       resolve relative paths against. -->
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/litellm.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/litellm.err</string>
</dict>
</plist>
