<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jkrumm.brain-snapshot</string>
  <!-- Nightly git-level safety-net snapshot of the brain vault. Captures the
       working tree (incl. untracked notes, .gitignore-respecting so secrets
       stay out) into refs/snapshots/<ts>. Never touches master/HEAD/index/
       working tree — LiveSync is the real backup; this is the git safety net. -->
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/SourceRoot/dotfiles/brain/brain-snapshot.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <!-- Don't snapshot on load/login — only at the scheduled time. -->
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/tmp/brain-snapshot.log</string>
  <key>StandardErrorPath</key><string>/tmp/brain-snapshot.log</string>
</dict>
</plist>
