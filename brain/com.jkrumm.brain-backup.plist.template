<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jkrumm.brain-backup</string>
  <!-- Nightly auto-commit + push of the brain vault to GitHub. Backstop for
       direct Obsidian edits never committed during a Claude Code session.
       With LiveSync retired (every replication trigger off, and no second
       device holding a checkout), this push is not a backstop to a sync
       layer — it IS the vault's only durability. -->
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/SourceRoot/dotfiles/brain/brain-backup.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <!-- Don't back up on load/login — only at the scheduled time. -->
  <key>RunAtLoad</key><false/>
  <!-- ~/Library/Logs, not /tmp: this file is the ONLY record that the nightly
       backup ran at all, and macOS's periodic cleanup sweeps /tmp files
       untouched for 3+ days. A calendar-driven agent re-creates its file each
       spawn so it never writes into an unlinked inode the way the KeepAlive
       agents do — but the history is deleted out from under it, which for an
       audit log is the same loss. -->
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/brain-backup.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/brain-backup.log</string>
</dict>
</plist>
