<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jkrumm.brain-backup</string>
  <!-- Nightly leftover-dirt sweep of the brain vault: commits and pushes
       whatever a Claude Code session left uncommitted. Mini-only in practice.
       It is NOT the sync layer — com.jkrumm.brain-sync is, every 5 minutes on
       both machines, and that agent deliberately never commits on the mini so
       that committing there stays a reviewed act. This job is the backstop for
       exactly that gap. LiveSync is retired; git through GitHub is both the
       sync mechanism and the durability. -->
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/SourceRoot/dotfiles/brain/brain-backup.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <!-- Don't back up on load/login — only at the scheduled time. -->
  <key>RunAtLoad</key><false/>
  <!-- ~/Library/Logs, not /tmp: this file is the ONLY record that the nightly
       backup ran at all, and macOS's periodic cleanup sweeps /tmp files
       untouched for 3+ days. A calendar-driven agent re-creates its file each
       spawn so it never writes into an unlinked inode the way the KeepAlive
       agents do — but the history is deleted out from under it, which for an
       audit log is the same loss. -->
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/brain-backup.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/brain-backup.log</string>
</dict>
</plist>
