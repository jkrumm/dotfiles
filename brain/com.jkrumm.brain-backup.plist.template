<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jkrumm.brain-backup</string>
  <!-- Nightly auto-commit + push of the brain vault to GitHub. Backstop for
       direct Obsidian edits never committed during a Claude Code session.
       LiveSync is the continuous cross-device sync; this is what keeps the
       GitHub copy actually current. -->
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/SourceRoot/dotfiles/brain/brain-backup.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <!-- Don't back up on load/login — only at the scheduled time. -->
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/tmp/brain-backup.log</string>
  <key>StandardErrorPath</key><string>/tmp/brain-backup.log</string>
</dict>
</plist>
