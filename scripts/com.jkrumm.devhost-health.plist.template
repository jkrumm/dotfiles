<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jkrumm.devhost-health</string>
  <!-- Remote-dev readiness heartbeat for the Mac mini (herdr + sshd +
       tailscaled + mosh), pushed to the `MacMini Dev Host - Push` monitor.
       Push rather than probe: the ACL has no tag:homelab → tag:mac grant, so
       Uptime Kuma cannot reach the mini. See scripts/devhost-health-check.sh. -->
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/SourceRoot/dotfiles/scripts/devhost-health-check.sh</string>
  </array>
  <!-- Every 5 minutes. The Kuma monitor's interval must be LONGER than this
       (600s is the paired value) so a single skipped run — laptop lid, a slow
       boot, a Tailscale reconnect — does not page on its own. -->
  <key>StartInterval</key><integer>300</integer>
  <!-- Fire on load so a reboot re-establishes the heartbeat immediately rather
       than leaving a 5-minute hole that reads as an outage. -->
  <key>RunAtLoad</key><true/>
  <!-- ~/Library/Logs, not /tmp: /tmp is world-writable, so another local user
       could pre-create the path as a symlink and have launchd clobber the
       target every 5 minutes. Nothing here is sensitive, but the issue class
       disappears for free. -->
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/devhost-health.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/devhost-health.log</string>
</dict>
</plist>
