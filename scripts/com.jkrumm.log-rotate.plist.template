<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jkrumm.log-rotate</string>
  <!-- 15-min copytruncate rotation for the LaunchAgent logs this repo owns.
       The rotation exists because moving those logs out of /tmp (WP9) removed
       the only thing that had ever bounded them: macOS's periodic cleanup,
       which does not truncate but DELETES, leaving KeepAlive agents writing
       into unlinked inodes. /tmp/walkingpad.err was 35 MB with no rotation at
       all. See scripts/log-rotate.sh for why copytruncate rather than rename,
       and why not newsyslog (it needs root; this machine's root password is
       deliberately MacBook-only). -->
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/jobrun</string>
    <string>com.jkrumm.log-rotate</string>
    <string>--owner</string><string>dotfiles</string>
    <string>--every</string><string>900</string>
    <string>--timeout</string><string>660</string>
    <string>--</string>
    <string>__DOTFILES_DIR__/scripts/log-rotate.sh</string>
  </array>
  <!-- jobrun is a bun script (`#!/usr/bin/env bun`) and launchd hands agents a minimal
       PATH, so bun's dir must be on it. The wrapped script keeps its own PATH setup. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <!-- Every 15 min (was hourly): the Chrome clone sweep must outpace ~300-600 clones/h (issue 839). A single `stat` per declared file costs nothing, and
       the cadence is what bounds a crash-looping agent to one hour's output
       above the cap instead of a day's. -->
  <key>StartInterval</key><integer>900</integer>
  <!-- Fire on load so a reboot bounds any log that grew while the machine was
       down or during a long uptime before the agent was installed. -->
  <key>RunAtLoad</key><true/>
  <!-- Its own log is deliberately NOT in the rotated set. One summary line per
       run at ~90 bytes every 15 min is ~3 MB/year, so it stays well
       under the 16 MB cap for years — and keeping
       it out means the script never truncates the file it is writing to. -->
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/log-rotate.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/log-rotate.log</string>
</dict>
</plist>
