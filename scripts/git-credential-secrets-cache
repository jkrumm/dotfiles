#!/usr/bin/env bash
set -euo pipefail

# git-credential-secrets-cache — a git credential helper that resolves the
# GitHub token from the same age-encrypted secrets cache every other headless
# consumer on the Mac mini uses (`secrets-run`), instead of the macOS keychain.
#
# Why not the `gh` keyring (which `make git-headless` used to rely on):
#
#   1. It rots invisibly. A `gh` token that expires or is revoked leaves
#      `gh auth git-credential get` exiting 0 with an EMPTY body — git then
#      falls through to prompting, and the only symptom is
#      `could not read Username for 'https://github.com'`, which reads like a
#      transport problem and sent an earlier diagnosis chasing SSH agent
#      forwarding. Observed on the mini 2026-07-26.
#   2. It is a credential outside the reviewed allowlist. Everything else the
#      mini holds is declared in `headless.refs` and therefore reviewable in a
#      git diff; a keyring token is opaque machine state that nothing in the
#      repo describes.
#   3. The cache has no session dependency at all — no login keychain, no GUI
#      session, no forwarded SSH agent. It resolves identically from a
#      LaunchAgent, a `claude --bg` daemon that outlived its ssh connection, a
#      herdr pane, and an interactive shell. That property is the whole point of
#      an always-on dev host.
#
# Rotation is `make secrets-seed` from a present-human machine — the ref is
# declared in `headless.refs`, so what the mini can hold is reviewable in git
# rather than being opaque keychain state.
#
# Protocol: https://git-scm.com/docs/gitcredentials#_custom_helpers
# Only `get` is implemented. `store`/`erase` are deliberate no-ops: the cache is
# sealed on the MacBook and is not writable from here, so silently accepting a
# store would imply a persistence this helper cannot provide.

# The mini's own push credential — deliberately NOT `op://hermes/github/token`,
# which is a read-only fine-grained PAT scoped to what Hermes reads. Splitting
# them does not stop a mini-resident agent from reading either (anything with
# `secrets-run` can read every cached ref); what it buys is that Hermes's env
# template keeps pointing at the read-only token, so Hermes cannot push through
# its configured credential, and the two rotate independently.
TOKEN_REF="${GIT_CREDENTIAL_SECRETS_REF:-op://mini/github/token}"
GIT_USER="${GIT_CREDENTIAL_SECRETS_USER:-jkrumm}"

# LaunchAgents get a minimal PATH and no shell aliases, so resolve by absolute
# path — same reasoning as devhost-health-check.sh.
SECRETS_RUN="${SECRETS_RUN_BIN:-$HOME/.local/bin/secrets-run}"

[[ "${1:-}" == "get" ]] || exit 0

# Git feeds the request on stdin (protocol=, host=, ...). Drain it: exiting
# without reading gives git EPIPE noise on some versions.
cat >/dev/null || true

[[ -x "$SECRETS_RUN" ]] || {
  echo "git-credential-secrets-cache: $SECRETS_RUN not executable" >&2
  exit 1
}

# Fail loud and EMPTY rather than partially: emitting a username with no
# password is exactly the gh failure mode this helper exists to replace — git
# would prompt for a password on a non-interactive host and hang or fail with a
# misleading message. If the ref cannot be resolved, say so on stderr and print
# nothing, so git moves to the next helper instead of half-authenticating.
if ! token=$("$SECRETS_RUN" read "$TOKEN_REF" 2>/dev/null); then
  echo "git-credential-secrets-cache: could not resolve $TOKEN_REF from the cache" >&2
  echo "  fix: run 'make secrets-seed' from the MacBook (biometric)" >&2
  exit 1
fi

[[ -n "$token" ]] || {
  echo "git-credential-secrets-cache: $TOKEN_REF resolved empty" >&2
  exit 1
}

printf 'username=%s\n' "$GIT_USER"
printf 'password=%s\n' "$token"
