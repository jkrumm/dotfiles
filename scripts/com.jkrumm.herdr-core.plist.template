<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jkrumm.herdr-core</string>
  <!-- A STARTER, not the core (mini only; the MacBook's core is started by the Herdr app). Outside ssh, `serve`
       detaches into upstream's own one-shot launchd job (`herdr-core --hc-launchd …`, parent pid 1) and this
       process exits 0; the detached process is the core, in the GUI session (keychain reach for Claude Max).
       Re-running it while a core runs is harmless (`serve` finds the lock and exits). Never KeepAlive: it would
       only relaunch an exiting starter. Booting it out does NOT stop the core.
       The program is upstream's signed Herdr Core.app at its fixed path, so the core, its holders and the
       programs in terminals are attributed to that bundle and one Full Disk Access grant on it covers them.
       Any other core (a client-started one over ssh, a Homebrew one) is attributed to something else.
       Details: docs/herdr-core.md §How the core runs now. A changed starter applies at the next login. -->
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/share/herdr-core/active/Herdr Core.app/Contents/MacOS/herdr-core</string>
    <string>serve</string>
  </array>
  <key>ProcessType</key><string>Interactive</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><false/>
  <key>AbandonProcessGroup</key><true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.local/bin:__HOME__/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LANG</key><string>en_US.UTF-8</string>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/herdr-core.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/herdr-core.log</string>
</dict>
</plist>
