<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jkrumm.ext-mirror</string>
  <!-- Nightly second local copy of the HomeLab's SSD share, HDD/fuji and HDD/Videos on the external volume
       (<volume>/mirror/{ssd,fuji,videos}), pulled over S3 with `hl`, behind the volume gate: a volume that is absent or
       locked is one "skipped" line, exit 3 (not green; retried hourly). See scripts/ext-mirror.py and docs/storage.md §EXT mirror. -->
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/jobrun</string>
    <string>com.jkrumm.ext-mirror</string>
    <string>--owner</string><string>dotfiles</string>
    <string>--every</string><string>86400</string>
    <string>--timeout</string><string>43200</string>
    <string>--lock</string><string>ext-mirror</string>
    <string>--</string>
    <string>__DOTFILES_DIR__/scripts/ext-mirror.py</string>
    <string>--if-due</string>
  </array>
  <!-- --timeout 43200: the path to the HomeLab carries about 9 MiB/s (docs/storage.md §EXT mirror), so a first or catch-up run takes hours; a wedged transfer must not hold the job open for ever
       (launchd would skip every later night). A held lock skips a run that overlaps a long one. -->
  <!-- jobrun is a bun script and launchd's PATH is minimal: bun's dir, ~/.local/bin (hl, secrets-run) and Homebrew
       (python3, rclone) must be on it. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.local/bin:__HOME__/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <!-- 05:00 is the night's run, after the HomeLab's 03:30 restic run and the 01:30 iCloud export, so the night's photos are in the copy.
       The same job fires every hour until 22:00 with --if-due: a run that was skipped (volume unreadable or HomeLab away, exit 3) or
       failed is tried again within the hour it can work, and once the copy is clean (younger than 18 h; 6 h while red) a trigger is a
       one-second no-op. Calendar intervals, so a fire missed asleep runs on wake. Not RunAtLoad: nothing here belongs on the boot path. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>RunAtLoad</key><false/>
  <key>Nice</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <!-- ~/Library/Logs, rotated by log-rotate (which derives it from this plist). -->
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/ext-mirror.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/ext-mirror.log</string>
</dict>
</plist>
