<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jkrumm.secrets-freshness</string>
  <!-- Weekly staleness HEARTBEAT for the SOPS+age secrets cache, pushed to
       Uptime Kuma. This is a reminder, never an automated reseed — the
       biometric half of a reseed can't be cron-approved (PRD N4), so this
       only nudges the human to run `make secrets-seed`. -->
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/SourceRoot/dotfiles/scripts/secrets-freshness-check.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>15</integer>
  </dict>
  <!-- Don't fire on load — only at the scheduled weekly reminder time. -->
  <key>RunAtLoad</key><false/>
  <!-- ~/Library/Logs, not /tmp — same reason as devhost-health's plist: /tmp is
       world-writable and macOS's periodic cleanup deletes files there untouched
       for 3+ days. At a WEEKLY cadence this log was guaranteed to be swept
       between runs, so it never held more than one entry. -->
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/secrets-freshness.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/secrets-freshness.log</string>
</dict>
</plist>
