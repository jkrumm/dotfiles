<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jkrumm.disk-budget</string>
  <!-- Daily comparison of the disk budget (config/mini/disk-budget.yaml) with du: one status file with
       measured and cap per row, one factory signal per row over its cap, one per uncovered path over
       5 GiB. Fails only when the table over-commits the volume or a signal is refused; a stalled row is
       reported unmeasured. See scripts/disk-budget.ts and docs/disk.md. -->
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/jobrun</string>
    <string>com.jkrumm.disk-budget</string>
    <string>--owner</string><string>dotfiles</string>
    <string>--every</string><string>86400</string>
    <string>--timeout</string><string>3600</string>
    <string>--</string>
    <string>__DOTFILES_DIR__/scripts/disk-budget.ts</string>
    <string>check</string>
  </array>
  <!-- --timeout 3600: the scans of ~ and /private walk some millions of files; a wedged du must not hold
       the job open. jobrun and the script are bun scripts (#!/usr/bin/env bun) and launchd hands agents a
       minimal PATH, so bun's dir and ~/.local/bin (factory) must be on it. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.bun/bin:__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <!-- 06:15, after the 04:40 sweep (which takes up to an hour when Docker is slow) so the table reads the swept disk. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>15</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/disk-budget.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/disk-budget.log</string>
</dict>
</plist>
