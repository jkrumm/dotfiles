<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jkrumm.photos-analysis-stop</string>
  <!-- Holds Photos analysis (mediaanalysisd) stopped: `launchctl disable` takes effect only at the next login, and a killed daemon
       respawns within minutes, so a SIGSTOP on the running process is what keeps its CPU at 0. docs/host-waste.md §mediaanalysisd. -->
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/jobrun</string>
    <string>com.jkrumm.photos-analysis-stop</string>
    <string>--owner</string><string>dotfiles</string>
    <string>--every</string><string>300</string>
    <string>--timeout</string><string>60</string>
    <string>--</string>
    <string>/bin/bash</string>
    <string>__DOTFILES_DIR__/scripts/host-waste-check.sh</string>
    <string>stop-mediaanalysisd</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.local/bin:__HOME__/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><false/>
  <!-- ~/Library/Logs, rotated by log-rotate (which derives it from this plist). -->
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/photos-analysis-stop.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/photos-analysis-stop.log</string>
</dict>
</plist>
