#!/usr/bin/env bash
set +x
set -euo pipefail
umask 077
ulimit -c 0 2>/dev/null || true  # no core dumps — they would capture decrypted secrets from memory

# secrets-run — run a command with a profile's secrets injected, or export them
# into the current shell. Two backends, selected by ~/.config/secrets/backend:
#
#   op    (MacBook, human present)  → varlock run/load, resolvers fire via
#                                     1Password desktop-app biometric.
#   cache (Mac mini, headless)      → sops+age decrypt in memory, completeness
#                                     preflight, then varlock run/export.
#
# Data (schemas + encrypted cache) lives in the private repo — see
# CONTRACT PATHS below and dotfiles-private/docs/design.md for the full model.
# This script only knows the contract paths; it never contains secret values.
#
# v1 constraint: dotenv values must be single-line (no embedded newlines).
#
# Usage:
#   secrets-run [--profile <name>] -- <cmd> [args...]
#   secrets-run --export <profile>

SECRETS_PRIVATE_REPO="${SECRETS_PRIVATE_REPO:-$HOME/SourceRoot/dotfiles-private}"
BACKEND_MARKER="$HOME/.config/secrets/backend"
AGE_KEY_FILE="$HOME/.config/sops/age/keys.txt"
SECRETS_MAX_AGE_DAYS="${SECRETS_MAX_AGE_DAYS:-14}"

usage() {
  cat >&2 <<'EOF'
Usage:
  secrets-run [--profile <name>] -- <cmd> [args...]
  secrets-run --export <profile>
EOF
}

die() {
  echo "✗ $*" >&2
  exit 1
}

detect_profile() {
  local toplevel src profile
  if toplevel=$(git rev-parse --show-toplevel 2>/dev/null); then
    profile=$(basename "$toplevel")
    src="$toplevel"
  else
    profile=$(basename "$PWD")
    src="$PWD"
  fi
  # 'baseline' is the always-on set, delivered only via the session hook's
  # `--export baseline`. It must never be auto-selected as a run profile just
  # because the cwd basename happens to be "baseline" (spoofable dir name).
  if [[ "$profile" == "baseline" ]]; then
    die "refusing to auto-select the 'baseline' profile from '$src' — pass an explicit --profile if this is intended"
  fi
  # Auto-selection is convenience, not a trust boundary (a same-user process can
  # decrypt any profile directly). Surface the choice so a wrong cwd is visible.
  echo "· auto-selected profile '$profile' from $src (override with --profile)" >&2
  printf '%s' "$profile"
}

resolve_schema() {
  local profile="$1" schema available f
  [[ -d "$SECRETS_PRIVATE_REPO" ]] \
    || die "private secrets repo not found at $SECRETS_PRIVATE_REPO — clone dotfiles-private or set SECRETS_PRIVATE_REPO"
  [[ -d "$SECRETS_PRIVATE_REPO/profiles" ]] \
    || die "no profiles/ directory in $SECRETS_PRIVATE_REPO — private repo not yet initialized"

  schema="$SECRETS_PRIVATE_REPO/profiles/$profile.env.schema"
  if [[ ! -f "$schema" ]]; then
    available=""
    for f in "$SECRETS_PRIVATE_REPO"/profiles/*.env.schema; do
      [[ -f "$f" ]] || continue
      available="$available $(basename "$f" .env.schema)"
    done
    available="${available# }"
    die "no schema for profile '$profile' (expected $schema). Available profiles: ${available:-none found}"
  fi
  printf '%s' "$schema"
}

read_backend() {
  [[ -f "$BACKEND_MARKER" ]] \
    || die "backend not configured (missing $BACKEND_MARKER) — run 'make setup' (see dotfiles-private runbook)"
  tr -d '[:space:]' < "$BACKEND_MARKER"
}

# Strip one pair of surrounding matching quotes (bash 3.2 — no negative offsets).
strip_quotes() {
  local v="$1" len first last
  len=${#v}
  if [[ $len -ge 2 ]]; then
    first="${v:0:1}"
    last="${v:$((len - 1)):1}"
    if [[ ("$first" == '"' && "$last" == '"') || ("$first" == "'" && "$last" == "'") ]]; then
      v="${v:1:$((len - 2))}"
    fi
  fi
  printf '%s' "$v"
}

warn_if_stale() {
  local profile="$1" seeded_at="${2:-}" seeded_epoch now_epoch age_days

  if [[ -z "$seeded_at" ]]; then
    echo "! cache for '$profile' has no _SECRETS_SEEDED_AT stamp — staleness unknown" >&2
    return 0
  fi
  if ! seeded_epoch=$(date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$seeded_at" "+%s" 2>/dev/null); then
    echo "! cache for '$profile' has an unparseable _SECRETS_SEEDED_AT ('$seeded_at') — staleness unknown" >&2
    return 0
  fi
  now_epoch=$(date -u "+%s")
  age_days=$(((now_epoch - seeded_epoch) / 86400))
  if ((age_days > SECRETS_MAX_AGE_DAYS)); then
    echo "! cache for '$profile' is ${age_days}d old (max ${SECRETS_MAX_AGE_DAYS}d) — consider: make secrets-seed PROFILES=$profile" >&2
  fi
  return 0
}

# Build a resolver-free RUNTIME schema from the authoring schema: drop the
# @plugin/@initOp lines and reduce every item to a bare `KEY=`. This is what
# varlock validates against on the mini, so at runtime varlock NEVER loads the
# 1Password plugin (third-party JS in the secrets-holding process) and NEVER
# reaches npm/network — closing R2 and shrinking the runtime attack surface to
# sops+age (Go) + varlock core. The runtime schema carries only names +
# decorators (no secret values, no op:// refs), so a 0600 temp is R1-safe.
make_runtime_schema() {
  local authoring="$1" out="$2"
  awk '
    /^#[[:space:]]*@plugin\(/  { next }
    /^#[[:space:]]*@initOp\(/  { next }
    /^[A-Za-z_][A-Za-z0-9_]*=/ { sub(/=.*/, "="); print; next }
    { print }
  ' "$authoring" >"$out"
}

# Parse a schema into declared_keys (every item) and required_keys (items not
# marked @optional; @defaultRequired=true is assumed per house schema headers).
# Attachment follows varlock's rule: a decorator applies to the next item and
# is broken only by a blank line or a `# ---` divider, not by plain comments.
declared_keys=()
required_keys=()
load_declared_keys() {
  local schema="$1" line pending_optional=0 key
  declared_keys=()
  required_keys=()
  while IFS= read -r line; do
    if [[ -z "$line" || "$line" == '# ---'* ]]; then
      pending_optional=0
      continue
    fi
    if [[ "$line" =~ ^#[[:space:]]*@optional || "$line" =~ ^#[[:space:]]*@required=false ]]; then
      pending_optional=1
      continue
    fi
    [[ "$line" == \#* ]] && continue
    if [[ "$line" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
      key="${line%%=*}"
      declared_keys+=("$key")
      ((pending_optional == 0)) && required_keys+=("$key")
      pending_optional=0
    fi
  done <"$schema"
}

_is_declared() {
  local needle="$1" k
  for k in ${declared_keys[@]+"${declared_keys[@]}"}; do
    [[ "$k" == "$needle" ]] && return 0
  done
  return 1
}

# Decrypt the cache in memory and export ONLY schema-declared keys. Any extra
# key in the cache (a forged/tampered cache can inject e.g. NODE_OPTIONS,
# DYLD_INSERT_LIBRARIES, PATH — the age recipient is public, so anything can
# encrypt a valid cache) is DROPPED and reported: varlock passes unknown ambient
# vars straight through to the child, so an allowlist is the injection guard.
# The _SECRETS_SEEDED_AT meta stamp is captured for staleness but never exported.
seeded_stamp=""
decrypt_and_export() {
  local cache_file="$1" decrypted line key value extras=()

  export SOPS_AGE_KEY_FILE="$AGE_KEY_FILE"
  # Capture stdout (the dotenv plaintext) SEPARATELY from stderr, so a sops
  # warning on a *successful* decrypt can never be parsed as a bogus dotenv line
  # (which would surface as a spurious "unexpected key — DROPPED" warning).
  local sops_err err
  sops_err=$(mktemp "${TMPDIR:-/tmp}/secrets-run.XXXXXX")
  if ! decrypted=$(sops --decrypt --input-type dotenv --output-type dotenv "$cache_file" 2>"$sops_err"); then
    err=$(cat "$sops_err")
    rm -f "$sops_err"
    die "sops decrypt failed for $cache_file: $err"
  fi
  rm -f "$sops_err"

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" ]] && continue
    [[ "$line" == \#* ]] && continue
    key="${line%%=*}"
    value="${line#*=}"
    value=$(strip_quotes "$value")
    if [[ "$key" == "_SECRETS_SEEDED_AT" ]]; then
      seeded_stamp="$value"
      continue
    fi
    if _is_declared "$key"; then
      export "$key=$value"
    else
      extras+=("$key")
    fi
  done <<<"$decrypted"

  if [[ ${#extras[@]} -gt 0 ]]; then
    echo "! cache contained ${#extras[@]} key(s) not declared in the schema — DROPPED (stale schema or tampering): ${extras[*]}" >&2
  fi
}

# Every required_keys[] entry must be a set variable (exported above) before
# anything runs — a fast fail-closed; varlock's own validation is the backstop.
# Optional items may legitimately be absent, so they are not required here.
preflight_completeness() {
  local profile="$1" key missing=()
  # Tripwire: load_declared_keys must have run first (it populates declared_keys).
  # An empty array here means the parse step was skipped/reordered — fail closed
  # rather than let the completeness check pass vacuously (fail-open).
  [[ ${#declared_keys[@]} -gt 0 ]] \
    || die "internal: schema for '$profile' parsed no declared keys — refusing to run"
  for key in ${required_keys[@]+"${required_keys[@]}"}; do
    declare -p "$key" >/dev/null 2>&1 || missing+=("$key")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    die "cache for profile '$profile' is missing required key(s): ${missing[*]} — reseed: make secrets-seed PROFILES=$profile"
  fi
}

# Emit `export K='V'` lines for schema-declared keys only, single-quote safe.
# Skips keys not present (optional + absent) to stay set-u-safe.
emit_export_lines() {
  local key value escaped
  for key in ${declared_keys[@]+"${declared_keys[@]}"}; do
    declare -p "$key" >/dev/null 2>&1 || continue
    value="${!key}"
    escaped=${value//\'/\'\\\'\'}
    printf "export %s='%s'\n" "$key" "$escaped"
  done
}

run_op_backend() {
  local schema="$1" mode="$2"
  shift 2
  command -v varlock >/dev/null 2>&1 || die "varlock not installed — brew install varlock"
  if [[ "$mode" == "export" ]]; then
    exec varlock load --path "$schema" --format shell --skip-cache
  fi
  exec varlock run --path "$schema" --skip-cache -- "$@"
}

# Global so the EXIT trap can clean it up after run_cache_backend returns
# (a function-local would be unbound in the trap under set -u).
RUNTIME_SCHEMA_TMP=""
cleanup_runtime_schema() { [[ -n "$RUNTIME_SCHEMA_TMP" ]] && rm -f "$RUNTIME_SCHEMA_TMP"; }

run_cache_backend() {
  local profile="$1" schema="$2" mode="$3" cache_file status
  shift 3

  command -v varlock >/dev/null 2>&1 || die "varlock not installed — brew install varlock"
  command -v sops >/dev/null 2>&1 || die "sops not installed — brew install sops"

  cache_file="$SECRETS_PRIVATE_REPO/cache/$profile.enc.env"
  [[ -f "$cache_file" ]] \
    || die "cache missing for profile '$profile' at $cache_file — run: make secrets-seed PROFILES=$profile"
  [[ -f "$AGE_KEY_FILE" ]] \
    || die "age key missing at $AGE_KEY_FILE — this machine is not set up as a cache backend"

  # Derive a resolver-free runtime schema (no plugin load / no network at
  # runtime). Non-secret; 0600 temp; cleaned up on any exit (we do NOT exec so
  # the trap can fire after the child returns).
  RUNTIME_SCHEMA_TMP=$(mktemp "${TMPDIR:-/tmp}/secrets-run.XXXXXX") \
    || die "could not create a temp file for the runtime schema"
  chmod 600 "$RUNTIME_SCHEMA_TMP"
  trap cleanup_runtime_schema EXIT
  make_runtime_schema "$schema" "$RUNTIME_SCHEMA_TMP"

  load_declared_keys "$RUNTIME_SCHEMA_TMP"
  decrypt_and_export "$cache_file"
  preflight_completeness "$profile"
  warn_if_stale "$profile" "$seeded_stamp"

  if [[ "$mode" == "export" ]]; then
    # Force varlock validation so --export also fails closed on a bad cache.
    if ! varlock load --path "$RUNTIME_SCHEMA_TMP" --skip-cache >/dev/null 2>&1; then
      die "cache for profile '$profile' failed validation — reseed: make secrets-seed PROFILES=$profile"
    fi
    emit_export_lines
    return 0
  fi

  set +e
  varlock run --path "$RUNTIME_SCHEMA_TMP" --skip-cache -- "$@"
  status=$?
  set -e
  return "$status"
}

main() {
  local profile="" mode="run"
  local -a cmd_args=()

  if [[ $# -eq 0 ]]; then
    usage
    exit 1
  fi

  if [[ "$1" == "--export" ]]; then
    mode="export"
    profile="${2:-}"
    [[ -n "$profile" ]] || { usage; die "--export requires a profile name"; }
    [[ $# -le 2 ]] || { usage; die "unexpected extra arguments after --export <profile>"; }
  else
    if [[ "$1" == "--profile" ]]; then
      profile="${2:-}"
      [[ -n "$profile" ]] || { usage; die "--profile requires a value"; }
      shift 2
    fi
    [[ "${1:-}" == "--" ]] || { usage; die "expected -- before the command"; }
    shift
    cmd_args=("$@")
    [[ ${#cmd_args[@]} -gt 0 ]] || { usage; die "no command given after --"; }
  fi

  [[ -n "$profile" ]] || profile=$(detect_profile)

  local schema backend
  schema=$(resolve_schema "$profile")
  backend=$(read_backend)

  case "$backend" in
    op) run_op_backend "$schema" "$mode" ${cmd_args[@]+"${cmd_args[@]}"} ;;
    cache) run_cache_backend "$profile" "$schema" "$mode" ${cmd_args[@]+"${cmd_args[@]}"} ;;
    *) die "unknown backend '$backend' in $BACKEND_MARKER (expected 'cache' or 'op')" ;;
  esac
}

main "$@"
