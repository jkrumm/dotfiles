#!/usr/bin/env bash
set +x
set -euo pipefail
umask 077
ulimit -c 0 2>/dev/null || true  # no core dumps — they would capture decrypted secrets from memory

# secrets-run — a drop-in `op` shim. Apps keep their own `.env.tpl` of
# `KEY=op://vault/item/field` lines and run through this instead of `op` itself;
# only the BACKEND differs per machine (~/.config/secrets/backend):
#
#   op    (MacBook, human present)  → passthrough to live `op` (biometric).
#   cache (Mac mini, headless)      → resolve op:// refs from the age-encrypted
#                                     cache (cache/secrets.enc.json), no prompts,
#                                     no network, no 1Password call.
#
# Same interface, same variable names, same app code on both machines. The cache
# is just a faster, offline, headless `op` backend — nothing more elaborate. See
# dotfiles-private/docs/design.md for the full model.
#
# Usage (mirrors `op`):
#   secrets-run run [--env-file=<tpl>]... -- <cmd> [args...]  # ~ op run --env-file
#   secrets-run read op://vault/item/field                    # ~ op read
#   secrets-run export [--env-file=<tpl>]...                   # emit `export K=V` lines
#
# ACCOUNTS. `OP_ACCOUNT` selects the 1Password account, exactly as `op --account`
# does, and defaults to tkrumm (personal). IU callers set it at the call site —
#   OP_ACCOUNT=careerpartner secrets-run run --env-file=… -- <cmd>
# — mirroring the `--account careerpartner` they pass `op` today. The account is
# needed only to seal (which account the seed reads from, decided by which ref-list
# a ref lives in) and to pass through to live `op`; a cache HIT needs no account
# beyond picking the key. The two accounts seed from separate ref-lists under
# separate Private-vault policies: headless.refs (tkrumm, Private forbidden) and
# headless.iu.refs (careerpartner, Private allowed — it is the IU work vault holding
# service identity, not personal human-only secrets). See design.md D14.
#
# `--env-file` may repeat (like `op run`): files merge in order, a later file
# overrides an earlier one for any duplicate key. `run`/`export` default to
# `.env.tpl` in the git root or cwd; `export` with no --env-file defaults to
# dotfiles-private/baseline.env.tpl (the always-on set).
#
# v1 constraint: values must be single-line (no embedded newlines).

# Headless callers (cron, launchd) invoke this with a minimal PATH that lacks the
# Homebrew bin dirs where sops/jq/op live, so the `command -v sops` checks below would
# fail "not installed" even though they are present. Prepend the standard Homebrew
# paths once, here, so no caller has to repeat the PATH dance. Homebrew ships no
# `date`/`mktemp`/`perl` under these names, so the BSD tools this script relies on
# (notably `date -j` in warn_if_stale) are NOT shadowed.
_prepend_path_once() {   # prepend $1 to PATH if absent; empty-PATH-safe (no trailing colon)
  case ":$PATH:" in
    *":$1:"*) : ;;
    *) PATH="$1${PATH:+:$PATH}" ;;
  esac
}
# Call least-preferred first: the LAST prepend lands in front, so /opt/homebrew/bin
# wins over /usr/local/bin (Apple-Silicon Homebrew-first; a stale /usr/local/bin binary
# must never shadow the vetted sops/jq). Prepend (not replace) preserves the caller's PATH.
_prepend_path_once /usr/local/bin
_prepend_path_once /opt/homebrew/bin
export PATH

SECRETS_PRIVATE_REPO="${SECRETS_PRIVATE_REPO:-$HOME/SourceRoot/dotfiles-private}"
BACKEND_MARKER="$HOME/.config/secrets/backend"
AGE_KEY_FILE="$HOME/.config/sops/age/keys.txt"
CACHE_FILE="$SECRETS_PRIVATE_REPO/cache/secrets.enc.json"
BASELINE_TPL="$SECRETS_PRIVATE_REPO/baseline.env.tpl"
# The account a bare (unqualified) cache key belongs to, and the default when a
# caller sets no OP_ACCOUNT. See cache_key() for why the default is special.
DEFAULT_OP_ACCOUNT="tkrumm"
OP_ACCOUNT="${OP_ACCOUNT:-$DEFAULT_OP_ACCOUNT}"
SECRETS_MAX_AGE_DAYS="${SECRETS_MAX_AGE_DAYS:-14}"
# Redact op://-resolved values at least this long from a command's piped output.
# Short values (a port, a boolean, a one-word channel id) are skipped so masking
# never corrupts unrelated output; real secrets are far longer than this.
REDACT_MIN_LEN="${REDACT_MIN_LEN:-5}"

usage() {
  cat >&2 <<'EOF'
Usage (mirrors op):
  secrets-run run [--env-file=<tpl>]... -- <cmd> [args...]
  secrets-run read op://vault/item/field
  secrets-run export [--env-file=<tpl>]...
  (--env-file may repeat; later files override earlier keys, like op run)
EOF
}

die() {
  echo "✗ $*" >&2
  exit 1
}

read_backend() {
  [[ -f "$BACKEND_MARKER" ]] \
    || die "backend not configured (missing $BACKEND_MARKER) — run 'make setup' (see dotfiles-private/docs/runbook.md)"
  tr -d '[:space:]' < "$BACKEND_MARKER"
}

# Parse one .env.tpl value the way `op run --env-file` does, so the shim stays a faithful
# drop-in. `op`'s parser was probed empirically on the mini (2026-07-15, op 2.x); the
# subset our templates use is replicated exactly, and every construct we do NOT replicate
# fails CLOSED (loud) rather than silently diverging — this shim is the sole secret path on
# the mini, so a silent mis-resolution would be undebuggable. Result → PARSED_VALUE.
#
# Faithful (verified against `op`):                    | `op` = us
#   FOO=ab#cd , FOO=ab #cd , FOO=ab\t#c                | ab      (unquoted: cut at FIRST '#', rtrim)
#   FOO=trail                                          | trail   (unquoted: rtrim trailing ws)
#   FOO="a # b" , FOO='a # b'                           | a # b   (either quote: '#' literal)
#   FOO="ab"   # c , FOO='ab'   # c                     | ab      (trailing ws + #comment dropped)
#   FOO="#FF0000" , FOO='p@ss$word' , FOO='a\b'          | as-is   (single quotes: FULLY literal)
# `op`'s quote handling is asymmetric and we mirror it: SINGLE quotes are literal — no escape,
# no ${VAR} — so we pass the content through verbatim. DOUBLE quotes get op's \-escaping and
# ${VAR} interpolation, and UNQUOTED values get op's backslash-escaping (\# , \$) + ${VAR}; we
# replicate NONE of those, so we FAIL CLOSED (die) on a backslash or '$' surviving in a
# double-quoted or unquoted value, on an unterminated quote, and on non-ws/non-# text after a
# closing quote. No real template needs those; a value that does belongs in single quotes (for
# a literal) or an op:// ref. Runs ONLY on the trusted committed template line — never on a
# resolved secret value — so a secret containing '#', '$' or '\' is never mangled.
# bash 3.2-safe (no negative offsets). Result → PARSED_VALUE.
PARSED_VALUE=""
parse_value() {                                  # parse_value <raw-value> [src-name-for-errors]
  local v="$1" src="${2:-env-file}" q rest body tail
  v="${v#"${v%%[![:space:]]*}"}"                 # ltrim
  q="${v:0:1}"
  if [[ "$q" == '"' || "$q" == "'" ]]; then
    rest="${v:1}"
    case "$rest" in
      *"$q"*) body="${rest%%"$q"*}"; tail="${rest#*"$q"}" ;;
      *) die "unterminated $q-quoted value in $src: $v" ;;
    esac
    # Single quotes are literal (op does no escaping/interpolation inside them); only
    # double quotes trigger op's \-escape + ${VAR} that we don't replicate → refuse those.
    if [[ "$q" == '"' ]]; then
      case "$body" in
        *\\*|*'$'*) die "double-quoted value uses a backslash-escape or \$-interpolation that secrets-run does not replicate from op ($src): $v — use single quotes for a literal, or move it into an op:// ref" ;;
      esac
    fi
    tail="${tail#"${tail%%[![:space:]]*}"}"       # ltrim what follows the close quote
    case "$tail" in
      '' | '#'*) : ;;                             # EOL or an inline comment — op drops both
      *) die "unexpected text after the closing quote (op rejects this) in $src: $v" ;;
    esac
    PARSED_VALUE="$body"
    return
  fi
  v="${v%%#*}"                                    # unquoted: drop inline comment at first '#'
  v="${v%"${v##*[![:space:]]}"}"                  # rtrim
  # op backslash-escapes (\#, \$) and interpolates ${VAR} in unquoted values; we do neither,
  # so a surviving backslash or '$' means op would transform this value → fail closed.
  case "$v" in
    *\\* | *'$'*) die "unquoted value contains a backslash or '\$' (op escapes/interpolates these; secrets-run does not) in $src: $v — single-quote it for a literal, or use an op:// ref" ;;
  esac
  PARSED_VALUE="$v"
}

# --- template parsing --------------------------------------------------------
# Parse an app's .env.tpl into aligned arrays. A ref line (KEY=op://...) is
# resolved from the backend; a literal line (KEY=value) is passed through as-is.
# Env var NAMES come only from the (committed, trusted) template — a forged cache
# can never introduce a new variable, because we iterate the template, not the
# cache. That is the structural injection guard.
TPL_KEYS=()
TPL_RAW=()
TPL_ISREF=()
TPL_NAME=""
parse_tpl() {
  local tpl="$1" line key val
  [[ -f "$tpl" ]] || die "env-file not found: $tpl"
  TPL_NAME="$tpl"
  TPL_KEYS=()
  TPL_RAW=()
  TPL_ISREF=()
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"   # ltrim
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" == export\ * ]] && line="${line#export }"
    [[ "$line" == *=* ]] || continue
    key="${line%%=*}"
    val="${line#*=}"
    [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] \
      || die "invalid env var name '$key' in $tpl"
    parse_value "$val" "$TPL_NAME"; val="$PARSED_VALUE"
    TPL_KEYS+=("$key")
    TPL_RAW+=("$val")
    if [[ "$val" == op://* ]]; then TPL_ISREF+=(1); else TPL_ISREF+=(0); fi
  done < "$tpl"
  # Zero keys is legitimate (an empty/comment-only template, e.g. an unpopulated
  # baseline) — a no-op, not an error. Callers handle empty arrays.
}

# Merge one or more templates into the aligned TPL_* arrays, mirroring how
# `op run` merges repeated --env-file: files are applied in order and a later
# file OVERRIDES an earlier one for any duplicate key (last-wins; verified
# against the 1Password CLI `run` reference). A duplicate key is thus resolved
# and emitted ONCE, from its last-declared line. The injection guard is
# unchanged — every key still comes only from a committed template, never the
# cache. bash 3.2-safe (guards empty-array `[@]` expansion under set -u).
parse_tpls() {                                  # parse_tpls <tpl> [<tpl> ...]
  local tpl key i j found
  local m_keys=() m_raw=() m_isref=() m_name=""
  for tpl in "$@"; do
    parse_tpl "$tpl"                            # fills TPL_KEYS/TPL_RAW/TPL_ISREF for this file
    [[ -n "$m_name" ]] && m_name="$m_name, $TPL_NAME" || m_name="$TPL_NAME"
    for ((i = 0; i < ${#TPL_KEYS[@]}; i++)); do
      key="${TPL_KEYS[$i]}"
      found=-1
      for ((j = 0; j < ${#m_keys[@]}; j++)); do
        if [[ "${m_keys[$j]}" == "$key" ]]; then found=$j; break; fi
      done
      if [[ $found -ge 0 ]]; then
        m_raw[found]="${TPL_RAW[$i]}"           # later file wins
        m_isref[found]="${TPL_ISREF[$i]}"
      else
        m_keys+=("$key"); m_raw+=("${TPL_RAW[$i]}"); m_isref+=("${TPL_ISREF[$i]}")
      fi
    done
  done
  TPL_NAME="$m_name"
  if [[ ${#m_keys[@]} -gt 0 ]]; then
    TPL_KEYS=("${m_keys[@]}"); TPL_RAW=("${m_raw[@]}"); TPL_ISREF=("${m_isref[@]}")
  else
    TPL_KEYS=(); TPL_RAW=(); TPL_ISREF=()
  fi
}

find_default_tpl() {
  local top
  if top=$(git rev-parse --show-toplevel 2>/dev/null) && [[ -f "$top/.env.tpl" ]]; then
    printf '%s' "$top/.env.tpl"
    return 0
  fi
  [[ -f "$PWD/.env.tpl" ]] && { printf '%s' "$PWD/.env.tpl"; return 0; }
  return 1
}

# --- cache backend -----------------------------------------------------------
CACHE_REFS=()
CACHE_VALS=()
SEEDED_STAMP=""
load_cache() {
  command -v sops >/dev/null 2>&1 || die "sops not installed — brew install sops"
  command -v jq >/dev/null 2>&1 || die "jq not installed — brew install jq"
  [[ -f "$CACHE_FILE" ]] \
    || die "cache missing at $CACHE_FILE — run: make secrets-seed"
  [[ -f "$AGE_KEY_FILE" ]] \
    || die "age key missing at $AGE_KEY_FILE — this machine is not set up as a cache backend"

  export SOPS_AGE_KEY_FILE="$AGE_KEY_FILE"
  local decrypted errf err ref val
  errf=$(mktemp "${TMPDIR:-/tmp}/secrets-run.XXXXXX")
  # Decrypt into memory (never a plaintext file — R1); capture stderr separately
  # so a warning on a successful decrypt can't be parsed as cache content.
  if ! decrypted=$(sops --decrypt --input-type json --output-type json "$CACHE_FILE" 2>"$errf"); then
    err=$(cat "$errf"); rm -f "$errf"
    die "sops decrypt failed for $CACHE_FILE: $err"
  fi
  rm -f "$errf"

  CACHE_REFS=()
  CACHE_VALS=()
  # NUL-delimited ref/value pairs via a pipe (no temp file, no argv exposure).
  while IFS= read -r -d '' ref && IFS= read -r -d '' val; do
    if [[ "$ref" == "_seeded_at" ]]; then SEEDED_STAMP="$val"; continue; fi
    CACHE_REFS+=("$ref")
    CACHE_VALS+=("$val")
  done < <(printf '%s' "$decrypted" | jq -j 'to_entries[] | .key + "\u0000" + (.value|tostring) + "\u0000"')
}

# `op` accepts several spellings of the same account (`careerpartner` and
# `careerpartner.1password.com` both resolve, and IU call sites use BOTH: feuer's
# Makefile passes the short form, analysis/op-env.sh the full domain). They must
# collapse to one string before they can key a cache entry, or the same secret
# would be sealed under one spelling and looked up under the other — a silent miss.
# Normalizing in both this shim and secrets-seed.sh (identical rule) is what keeps
# seal and lookup in agreement.
# MUST stay byte-identical to secrets-seed.sh's copy — see the cache_key note below.
normalize_account() {  # $1=account → prints its canonical short form
  local a
  # Case-fold FIRST: `op` matches account identifiers case-insensitively, so
  # `CareerPartner` and `careerpartner` are one account to op — but two different
  # strings to a cache key. Folding before the suffix strip also catches a
  # `.1Password.com` spelling. Without this the op backend (which delegates the
  # match to op) and the cache backend (which string-compares) disagree on the same
  # input — precisely the divergence this shim exists to prevent.
  # bash 3.2 has no ${var,,}, hence tr.
  a=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  a="${a%.1password.com}"
  # '|' separates account from ref in a namespaced key. An account containing one
  # would make the key ambiguous (account `a|b` + ref `c` vs account `a` + ref `b|c`),
  # so refuse rather than seal something that cannot be looked up unambiguously.
  case "$a" in
    *'|'*) die "invalid OP_ACCOUNT '$1' — an account name may not contain '|'" ;;
  esac
  printf '%s' "$a"
}

# The cache key for a ref under the CURRENT account.
#
# The default account (tkrumm) keys BARE — exactly the ref, as before multi-account
# support existed — so a cache sealed by an older seed keeps resolving and the live
# mini never depends on a reseed to stay up. Any other account is NAMESPACED, because
# a flat keyspace cannot hold two accounts at once: both tkrumm and careerpartner own
# a vault literally named `Private`, so `op://Private/...` is ambiguous across them.
# '|' separates: it cannot appear in an account name, and (unlike a tab) JSON does not
# escape it — the seed's ciphertext key check greps for the literal key.
cache_key() {  # $1=ref → prints the cache key for it under $OP_ACCOUNT
  local acct
  acct=$(normalize_account "$OP_ACCOUNT")
  if [[ "$acct" == "$DEFAULT_OP_ACCOUNT" ]]; then
    printf '%s' "$1"
  else
    printf '%s|%s' "$acct" "$1"
  fi
}

cache_lookup() {  # $1=ref → prints value; returns 1 if the ref is not in the cache
  local ref="$1" key i
  key=$(cache_key "$ref")
  for ((i = 0; i < ${#CACHE_REFS[@]}; i++)); do
    if [[ "${CACHE_REFS[$i]}" == "$key" ]]; then
      printf '%s' "${CACHE_VALS[$i]}"
      return 0
    fi
  done
  return 1
}

# Which ref-list a missing ref belongs in — the two accounts seed from different
# files (and under different Private-vault policies), so a "reseed" hint that names
# the wrong file sends the reader to edit a list that can never satisfy them.
refs_file_hint() {
  local acct
  acct=$(normalize_account "$OP_ACCOUNT")
  if [[ "$acct" == "$DEFAULT_OP_ACCOUNT" ]]; then
    printf 'headless.refs'
  else
    printf 'headless.iu.refs'
  fi
}

warn_if_stale() {
  local seeded_epoch now_epoch age_days
  [[ -n "$SEEDED_STAMP" ]] || return 0
  if ! seeded_epoch=$(date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$SEEDED_STAMP" "+%s" 2>/dev/null); then
    return 0
  fi
  now_epoch=$(date -u "+%s")
  age_days=$(((now_epoch - seeded_epoch) / 86400))
  if ((age_days > SECRETS_MAX_AGE_DAYS)); then
    echo "! secrets cache is ${age_days}d old (max ${SECRETS_MAX_AGE_DAYS}d) — consider: make secrets-seed" >&2
  fi
}

# Resolve every template entry into OUT_VALS[] (aligned to TPL_KEYS[]); collect
# op://-resolved values worth redacting into REDACT_VALUES[]. Fail closed listing
# every ref the cache is missing, before anything runs (R4).
OUT_VALS=()
REDACT_VALUES=()

# Append a resolved op:// value: to OUT_VALS[] always, and to REDACT_VALUES[] when
# long enough to mask. One place so the two backends can never drift on the check.
_accumulate_ref_value() {
  OUT_VALS+=("$1")
  [[ ${#1} -ge $REDACT_MIN_LEN ]] && REDACT_VALUES+=("$1")
  return 0
}

resolve_from_cache() {
  local i raw val missing=()
  OUT_VALS=()
  REDACT_VALUES=()
  for ((i = 0; i < ${#TPL_KEYS[@]}; i++)); do
    raw="${TPL_RAW[$i]}"
    if [[ "${TPL_ISREF[$i]}" == 1 ]]; then
      if val=$(cache_lookup "$raw"); then
        _accumulate_ref_value "$val"
      else
        missing+=("${TPL_KEYS[$i]} → $raw")
        OUT_VALS+=("")
      fi
    else
      OUT_VALS+=("$raw")   # literal config value — not redacted
    fi
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    die "cache is missing ${#missing[@]} ref(s) needed by $TPL_NAME (account $(normalize_account "$OP_ACCOUNT")): ${missing[*]} — add to $(refs_file_hint) and reseed: make secrets-seed"
  fi
}

resolve_from_op() {
  local i raw val
  command -v op >/dev/null 2>&1 || die "op (1Password CLI) not installed"
  OUT_VALS=()
  REDACT_VALUES=()
  for ((i = 0; i < ${#TPL_KEYS[@]}; i++)); do
    raw="${TPL_RAW[$i]}"
    if [[ "${TPL_ISREF[$i]}" == 1 ]]; then
      val=$(op read --account "$OP_ACCOUNT" "$raw") \
        || die "op read failed for $raw (account $OP_ACCOUNT)"
      _accumulate_ref_value "$val"
    else
      OUT_VALS+=("$raw")   # literal config value — not redacted
    fi
  done
}

export_resolved() {  # export OUT_VALS[] under their TPL_KEYS[]
  local i
  for ((i = 0; i < ${#TPL_KEYS[@]}; i++)); do
    export "${TPL_KEYS[$i]}=${OUT_VALS[$i]}"
  done
}

emit_export_lines() {  # `export K='V'` lines, single-quote-safe
  local i k v esc
  for ((i = 0; i < ${#TPL_KEYS[@]}; i++)); do
    k="${TPL_KEYS[$i]}"
    v="${OUT_VALS[$i]}"
    esc=${v//\'/\'\\\'\'}
    printf "export %s='%s'\n" "$k" "$esc"
  done
}

# Filter a stream, replacing each redact value (read from fd 3) with <redacted>.
# Values reach perl via fd 3 (a pipe fed by the builtin printf) — never argv or
# a temp file, so they are not exposed in `ps` or on disk. Literal-string match,
# longest-first; single-line values only (the v1 constraint), so line-by-line
# streaming is exact.
redact_filter() {
  perl -e '
    $| = 1;   # autoflush: stream per-line to the pipe (must precede the loop)
    my @v;
    open(my $f, "<&=3") or die "fd3: $!";
    while (my $l = <$f>) { chomp $l; push @v, $l if length $l; }
    close $f;
    @v = sort { length($b) <=> length($a) } @v;
    while (my $line = <STDIN>) {
      for my $s (@v) { my $q = quotemeta($s); $line =~ s/$q/<redacted>/g; }
      print $line;
    }
  '
}

run_with_redaction() {  # run "$@" masking resolved values from any REDIRECTED stream
  local st
  # Decide redaction PER STREAM: a real terminal (the human) gets raw pass-through;
  # a redirected/piped stream (the agent case) gets masked. Gating only on stdout
  # would leak an unredacted `cmd 2>agent.log` when stdout is still a tty.
  if [[ ${#REDACT_VALUES[@]} -eq 0 ]] || { [[ -t 1 ]] && [[ -t 2 ]]; }; then
    set +e; "$@"; st=$?; set -e
    return "$st"
  fi
  # Values reach each perl via fd 3 (a pipe fed by builtin printf — never argv or a
  # temp file). stdout rides the foreground pipe so the child's own exit code is
  # PIPESTATUS[0]; stderr rides a process substitution, drained with `wait` so no
  # trailing redacted line is lost. Streams stay SEPARATE (like `op run`) so a
  # caller capturing `$(...)` gets clean stdout with no stderr folded in.
  if [[ -t 1 ]]; then
    # stdout is a terminal (raw); only stderr is redirected → redact stderr only.
    set +e
    "$@" 2> >(redact_filter 3< <(printf '%s\n' "${REDACT_VALUES[@]}") >&2)
    st=$?
    wait
    set -e
    return "$st"
  fi
  if [[ -t 2 ]]; then
    # stderr is a terminal (raw); only stdout is redirected → redact stdout only.
    set +e
    "$@" | redact_filter 3< <(printf '%s\n' "${REDACT_VALUES[@]}")
    st=${PIPESTATUS[0]}
    set -e
    return "$st"
  fi
  # Both redirected → redact both.
  set +e
  "$@" 2> >(redact_filter 3< <(printf '%s\n' "${REDACT_VALUES[@]}") >&2) \
    | redact_filter 3< <(printf '%s\n' "${REDACT_VALUES[@]}")
  st=${PIPESTATUS[0]}
  wait
  set -e
  return "$st"
}

# --- verbs -------------------------------------------------------------------

# Parse a run of leading `--env-file=<tpl>` | `--env-file <tpl>` flags from "$@" into
# ENVFILE_TPLS[] (in command-line order; empty if none) and set ENVFILE_SHIFT (how many
# args to consume). `op run` accepts repeated --env-file and merges them — later files
# override earlier keys (verified: 1Password CLI `run` reference). The caller does the
# shift, since a function cannot shift its caller's positional parameters.
ENVFILE_TPLS=()
ENVFILE_SHIFT=0
parse_env_file_flags() {
  ENVFILE_TPLS=()
  ENVFILE_SHIFT=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --env-file=*)
        ENVFILE_TPLS+=("${1#--env-file=}")
        shift; ENVFILE_SHIFT=$((ENVFILE_SHIFT + 1)) ;;
      --env-file)
        [[ -n "${2:-}" ]] || { usage; die "--env-file requires a path"; }
        ENVFILE_TPLS+=("$2")
        shift 2; ENVFILE_SHIFT=$((ENVFILE_SHIFT + 2)) ;;
      *) break ;;
    esac
  done
}

verb_read() {
  local ref="${1:-}" backend
  [[ -n "$ref" ]] || { usage; die "read requires an op:// reference"; }
  [[ "$ref" == op://* ]] || die "not an op:// reference: $ref"
  backend=$(read_backend)
  case "$backend" in
    op)
      command -v op >/dev/null 2>&1 || die "op (1Password CLI) not installed"
      exec op read --account "$OP_ACCOUNT" "$ref"
      ;;
    cache)
      load_cache
      local val
      if val=$(cache_lookup "$ref"); then
        printf '%s\n' "$val"
      else
        die "ref not in cache: $ref (account $(normalize_account "$OP_ACCOUNT")) — add to $(refs_file_hint) and reseed: make secrets-seed"
      fi
      ;;
    *) die "unknown backend '$backend' in $BACKEND_MARKER (expected 'cache' or 'op')" ;;
  esac
}

verb_run() {
  local backend dflt f
  local ef_args=()
  parse_env_file_flags "$@"
  shift "$ENVFILE_SHIFT"
  [[ "${1:-}" == "--" ]] || { usage; die "expected -- before the command"; }
  shift
  [[ $# -gt 0 ]] || { usage; die "no command given after --"; }

  if [[ ${#ENVFILE_TPLS[@]} -eq 0 ]]; then
    dflt=$(find_default_tpl) \
      || die "no --env-file given and no .env.tpl found in the git root or cwd"
    ENVFILE_TPLS=("$dflt")
    echo "· using $dflt" >&2
  fi

  backend=$(read_backend)
  case "$backend" in
    op)
      command -v op >/dev/null 2>&1 || die "op (1Password CLI) not installed"
      # Passthrough to live op — native resolution, native merge (last file wins),
      # native output redaction. (No parse_tpl: op reads the env-files itself.)
      for f in "${ENVFILE_TPLS[@]}"; do ef_args+=("--env-file=$f"); done
      exec op run --account "$OP_ACCOUNT" "${ef_args[@]}" -- "$@"
      ;;
    cache)
      parse_tpls "${ENVFILE_TPLS[@]}"
      # A non-empty (merged) template set resolves from the cache; an empty one injects
      # nothing (no cache needed) and just runs the command. REDACT_VALUES stays empty,
      # so run_with_redaction runs raw.
      if [[ ${#TPL_KEYS[@]} -gt 0 ]]; then
        load_cache
        resolve_from_cache
        warn_if_stale
        export_resolved
      fi
      run_with_redaction "$@"
      ;;
    *) die "unknown backend '$backend' in $BACKEND_MARKER (expected 'cache' or 'op')" ;;
  esac
}

verb_export() {
  local backend
  parse_env_file_flags "$@"
  shift "$ENVFILE_SHIFT"
  [[ $# -eq 0 ]] || { usage; die "unexpected extra arguments after export"; }
  [[ ${#ENVFILE_TPLS[@]} -gt 0 ]] || ENVFILE_TPLS=("$BASELINE_TPL")

  parse_tpls "${ENVFILE_TPLS[@]}"   # both backends iterate the merged template to emit export lines
  # An empty template (e.g. an unpopulated baseline) is a clean no-op — don't
  # touch the backend/cache at all, so a fresh shell never warns before seeding.
  [[ ${#TPL_KEYS[@]} -eq 0 ]] && return 0

  backend=$(read_backend)
  case "$backend" in
    op)
      resolve_from_op
      emit_export_lines
      ;;
    cache)
      load_cache
      resolve_from_cache
      warn_if_stale
      emit_export_lines
      ;;
    *) die "unknown backend '$backend' in $BACKEND_MARKER (expected 'cache' or 'op')" ;;
  esac
}

main() {
  [[ $# -gt 0 ]] || { usage; exit 1; }
  local verb="$1"; shift
  case "$verb" in
    run) verb_run "$@" ;;
    read) verb_read "$@" ;;
    export) verb_export "$@" ;;
    -h | --help) usage; exit 0 ;;
    *) usage; die "unknown verb '$verb' (expected run|read|export)" ;;
  esac
}

main "$@"
