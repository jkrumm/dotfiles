+// In-memory carrier keyed by job id: enough for a spike; a real change persists it with the job
+// so an adopted-after-restart job keeps its parent.
+const TRACEPARENT_RE = /^00-([0-9a-f]{32})-([0-9a-f]{16})-[0-9a-f]{2}$/
+
+export function parseTraceparent(header: string | null | undefined): { traceId: string; spanId: string } | undefined {
+  const m = header ? TRACEPARENT_RE.exec(header.trim().toLowerCase()) : null
+  if (!m || /^0+$/.test(m[1]!) || /^0+$/.test(m[2]!)) return undefined
+  return { traceId: m[1]!, spanId: m[2]! }
+}
+
