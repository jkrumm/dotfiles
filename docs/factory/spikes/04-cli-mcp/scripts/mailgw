#!/usr/bin/env python3
"""mailgw: scratch read-only CLI over the email-gateway bearer REST API (Spike 4; email-gateway ships no CLI)."""
import json, os, sys, urllib.error, urllib.parse, urllib.request

HELP = """mailgw — read-only command-line client for the email-gateway REST door

Usage:
  mailgw needs-action [--account A] [--since ISO] [--until ISO] [--limit N]   messages the classifier flagged
  mailgw search <query> [--account A] [--limit N]   full-text search over envelopes
  mailgw read <key> [--body]   one message (envelope, classification, cached body)
  mailgw list [--account A] [--direction inbound|outbound] [--since ISO] [--until ISO] [--limit N]   newest first, flags included

Environment: MAILGW_URL base URL, MAILGW_KEY bearer key. Output: compact JSON on stdout.
Exit codes: 0 ok · 1 API error · 2 usage error · 3 server unreachable
"""
ROUTES = {"needs-action": "/api/needs-action", "search": "/api/search", "list": "/api/messages"}


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(HELP, end="")
        return 0
    cmd, rest, params, pos, i = argv[0], [a for a in argv[1:] if a != "--json"], {}, [], 0  # output is always JSON
    while i < len(rest):
        if rest[i] == "--body":
            params["include"] = "body"
        elif rest[i].startswith("--") and i + 1 < len(rest):
            params[rest[i][2:]], i = rest[i + 1], i + 1
        else:
            pos.append(rest[i])
        i += 1
    if cmd == "read" and len(pos) == 1:
        path = "/api/messages/" + urllib.parse.quote(pos[0])
    elif cmd == "search" and pos:
        path, params["q"] = ROUTES[cmd], " ".join(pos)
    elif cmd in ("needs-action", "list"):
        path = ROUTES[cmd]
    else:
        print(f"mailgw: bad command or arguments (see --help): {cmd}", file=sys.stderr)
        return 2
    url = os.environ.get("MAILGW_URL", "http://127.0.0.1:39107") + path + ("?" + urllib.parse.urlencode(params) if params else "")
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers={"Authorization": "Bearer " + os.environ.get("MAILGW_KEY", "")})) as r:
            print(json.dumps(json.load(r), separators=(",", ":")))
        return 0
    except urllib.error.URLError as e:  # HTTPError is a URLError with a status code
        code = getattr(e, "code", None)
        print(f"mailgw: HTTP {code}: {e.read().decode()[:300]}" if code else f"mailgw: server unreachable: {e.reason}", file=sys.stderr)
        return 1 if code else 3
sys.exit(main(sys.argv[1:]))
