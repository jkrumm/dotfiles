{
  "info": {
    "title": "research-gateway",
    "description": "Agentic research gateway. Accepts a query, runs a multi-step tool-calling loop (web search + page fetch + source-of-truth lookups), and returns a cited markdown report. Every route except the public ones listed by `GET /` (discovery, `/health*`, `/openapi*`) requires `Authorization: Bearer <API_SECRET>`.",
    "version": "0.1.0",
    "x-source": "GET /openapi/json + overlay (operationId, x-cli)"
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {}
  },
  "tags": [
    {
      "name": "Research",
      "description": "Submit and poll agentic research jobs."
    },
    {
      "name": "System",
      "description": "Discovery and health endpoints."
    }
  ],
  "openapi": "3.1.2",
  "paths": {
    "/research": {
      "post": {
        "tags": [
          "Research"
        ],
        "summary": "Submit a research query",
        "description": "Enqueues an agentic research job and returns a jobId immediately. Poll `GET /research/:jobId` to check status and retrieve the result.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 3
                  },
                  "depth": {
                    "type": "string",
                    "enum": [
                      "quick",
                      "standard",
                      "deep"
                    ]
                  },
                  "context": {
                    "description": "Optional free-text background the caller already knows. Treated as established: it is NOT re-searched or re-verified, and it is never cited (it has no URL). Use it to skip re-deriving facts shared across jobs.",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000
                  },
                  "idempotencyKey": {
                    "description": "Optional caller-supplied key (1..200 chars). Retrying a submit with the same key returns the original job instead of starting a second one.",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "query"
                ],
                "additionalProperties": false
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 3
                  },
                  "depth": {
                    "type": "string",
                    "enum": [
                      "quick",
                      "standard",
                      "deep"
                    ]
                  },
                  "context": {
                    "description": "Optional free-text background the caller already knows. Treated as established: it is NOT re-searched or re-verified, and it is never cited (it has no URL). Use it to skip re-deriving facts shared across jobs.",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000
                  },
                  "idempotencyKey": {
                    "description": "Optional caller-supplied key (1..200 chars). Retrying a submit with the same key returns the original job instead of starting a second one.",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "query"
                ],
                "additionalProperties": false
              }
            },
            "multipart/form-data": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 3
                  },
                  "depth": {
                    "type": "string",
                    "enum": [
                      "quick",
                      "standard",
                      "deep"
                    ]
                  },
                  "context": {
                    "description": "Optional free-text background the caller already knows. Treated as established: it is NOT re-searched or re-verified, and it is never cited (it has no URL). Use it to skip re-deriving facts shared across jobs.",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000
                  },
                  "idempotencyKey": {
                    "description": "Optional caller-supplied key (1..200 chars). Retrying a submit with the same key returns the original job instead of starting a second one.",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "query"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Response for status 200",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "jobId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "jobId",
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "429": {
            "description": "Response for status 429",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Response for status 503",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "operationId": "researchSubmit",
        "x-cli": {
          "command": [
            "research",
            "run"
          ],
          "positional": [
            "query"
          ],
          "defaultFormat": "plain",
          "plainField": "result.report",
          "mutating": true,
          "job": {
            "statusOperationId": "researchStatus",
            "idField": "jobId",
            "statusField": "status",
            "terminal": [
              "done",
              "error",
              "cancelled"
            ],
            "successStatus": "done",
            "resume": {
              "command": [
                "research",
                "wait"
              ]
            }
          }
        }
      }
    },
    "/research/{jobId}": {
      "get": {
        "tags": [
          "Research"
        ],
        "summary": "Poll a research job",
        "description": "Returns the current status of a research job, plus live fields: `queuePosition` while queued, `progress` (phase, round, workers done/total) while running, timestamps, and the measured p50/p90 duration for its depth. When `status` is `done`, `result` contains the research report. When `status` is `error` or `cancelled`, `error` says why.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Response for status 200",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "depth": {
                      "type": "string",
                      "enum": [
                        "quick",
                        "standard",
                        "deep"
                      ]
                    },
                    "submittedAt": {
                      "type": "string",
                      "description": "ISO time the job was created."
                    },
                    "startedAt": {
                      "description": "ISO time it got a slot and started running; null while queued.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "finishedAt": {
                      "description": "ISO time it reached a terminal status.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "queuePosition": {
                      "description": "1-based place in the line while queued (1 = starts next); null otherwise.",
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "progress": {
                      "description": "Live phase while running; null when queued or terminal.",
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "phase": {
                          "type": "string",
                          "enum": [
                            "planning",
                            "researching",
                            "synthesizing",
                            "reviewing"
                          ],
                          "description": "planning = lead model decomposing the query; researching = workers out; synthesizing = writing the report; reviewing = the consistency pass (last LLM call)."
                        },
                        "round": {
                          "type": "number",
                          "description": "Research round, 1-based; > 1 means a gap-filling round."
                        },
                        "workers": {
                          "type": "object",
                          "properties": {
                            "done": {
                              "type": "number"
                            },
                            "total": {
                              "type": "number"
                            }
                          },
                          "required": [
                            "done",
                            "total"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "phase",
                        "round",
                        "workers"
                      ],
                      "additionalProperties": false
                    },
                    "typicalDurationMs": {
                      "type": "object",
                      "properties": {
                        "p50": {
                          "type": "number"
                        },
                        "p90": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "p50",
                        "p90"
                      ],
                      "additionalProperties": false,
                      "description": "Measured run time for this depth (docs/measurements.md) — a range to judge \"stuck\" against, not an ETA."
                    },
                    "result": {
                      "type": "object",
                      "properties": {
                        "report": {
                          "type": "string",
                          "description": "Narrative, cited answer in markdown"
                        },
                        "citations": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "claim": {
                                "type": "string"
                              },
                              "url": {
                                "type": "string"
                              },
                              "confidence": {
                                "type": "string",
                                "enum": [
                                  "high",
                                  "medium",
                                  "low"
                                ],
                                "description": "The worker's confidence in this specific claim, carried through from the source digest."
                              }
                            },
                            "required": [
                              "claim",
                              "url",
                              "confidence"
                            ],
                            "additionalProperties": false
                          },
                          "description": "Each key claim tied to a source URL"
                        },
                        "sources": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "Deduplicated list of all source URLs consulted"
                        },
                        "unverified": {
                          "default": [],
                          "description": "Claims or topics the report could NOT verify against a source, aggregated from the digests' blockedSources. A transparency channel to the caller — distinct from citations, which are claims that WERE verified.",
                          "maxItems": 200,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "topic": {
                                "type": "string"
                              },
                              "url": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "maxLength": 2048
                              },
                              "reason": {
                                "type": "string",
                                "maxLength": 1000
                              }
                            },
                            "required": [
                              "topic",
                              "url",
                              "reason"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "status": {
                          "default": "ok",
                          "description": "'partial' means evidence was lost this run — at least 10% of the cited claims were dropped for lack of a retrieved source, the prose names an unverifiable source, or nothing could be retrieved at all. Treat prose in a 'partial' report as unconfirmed unless a citation backs it. An 'ok' report can still have lost a few citations: they are listed in `unverified` and counted in `warnings`.",
                          "type": "string",
                          "enum": [
                            "ok",
                            "partial"
                          ]
                        },
                        "warnings": {
                          "default": [],
                          "description": "Human-readable notes about degraded evidence for this run. Empty on a clean run.",
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "grounding": {
                          "type": "object",
                          "properties": {
                            "pagesRetrieved": {
                              "type": "number",
                              "description": "Pages whose full text was actually retrieved this run."
                            },
                            "pagesMissing": {
                              "type": "number",
                              "description": "Pages where the origin itself answered 404/410 — definitive absence, not a fetch failure."
                            },
                            "pagesFailed": {
                              "type": "number",
                              "description": "Pages a fetch was attempted on and failed (rate limit, error, refusal)."
                            },
                            "citationsKept": {
                              "type": "number",
                              "description": "Citations backed by a page this run actually retrieved or saw as a search snippet."
                            },
                            "citationsDropped": {
                              "type": "number",
                              "description": "Citations removed because the URL was never retrieved, or its fetch failed. Each is restated in `unverified`."
                            },
                            "confidenceCapped": {
                              "type": "number",
                              "description": "Citations whose asserted confidence was lowered to match what was actually retrieved."
                            },
                            "citationsDegraded": {
                              "type": "number",
                              "description": "Of the capped citations, those whose claim names the subject of an `unverified` entry. A cap is not lost evidence, so this alone does not make a run `partial`; it is the transparency signal for why a citation sits at `low`."
                            },
                            "citationsNumberUnmatched": {
                              "default": 0,
                              "description": "Of the capped citations, those quoting a number that does not occur in the text retrieved from the page they cite (invented, carried over from another page, or computed). Each is capped at `low` and restated in `unverified`.",
                              "type": "number"
                            },
                            "partialCause": {
                              "description": "Why `status` is 'partial' (null when it is 'ok'): `dropped` at least 10% of the cited claims were removed (fewer is reported in `warnings` and `unverified`, status stays 'ok'), `scrubbed` the prose names an unverifiable source, `no-pages` nothing was retrieved, `failures` fetch failures outnumber successes. First match wins, in that order.",
                              "type": [
                                "string",
                                "null"
                              ],
                              "enum": [
                                "dropped",
                                "scrubbed",
                                "no-pages",
                                "failures"
                              ]
                            }
                          },
                          "required": [
                            "pagesRetrieved",
                            "pagesMissing",
                            "pagesFailed",
                            "citationsKept",
                            "citationsDropped",
                            "confidenceCapped",
                            "citationsDegraded",
                            "citationsNumberUnmatched"
                          ],
                          "additionalProperties": false,
                          "description": "Machine-checked evidence accounting — counted in code, not asserted by the model."
                        },
                        "cost": {
                          "type": "object",
                          "properties": {
                            "wallMs": {
                              "type": "number",
                              "description": "End-to-end duration of the run in milliseconds."
                            },
                            "totalUsd": {
                              "description": "llmUsd + searchUsd. Null when the LLM rate table has no entry for the configured model.",
                              "type": [
                                "number",
                                "null"
                              ]
                            },
                            "llmUsd": {
                              "description": "Lead + worker token spend, computed from the local rate table (cache-aware).",
                              "type": [
                                "number",
                                "null"
                              ]
                            },
                            "searchUsd": {
                              "type": "number",
                              "description": "Web-search spend, as reported by the vendor's own per-call cost."
                            },
                            "searchCalls": {
                              "type": "number",
                              "description": "Billed search calls this run — cache hits excluded."
                            },
                            "tavilyCredits": {
                              "type": "number",
                              "description": "Tavily credits consumed by search calls (and any fallback search). Does NOT cover page extraction — measured directly against the API, a one-URL extract call always reports 0 credits, so this number understates true Tavily usage whenever fetchPage falls back to Extract. Not priced — no verified USD-per-credit rate exists. See tavilyExtractCalls for the extraction signal."
                            },
                            "tavilyExtractCalls": {
                              "type": "number",
                              "description": "Tavily Extract calls made by fetchPage. Measured fact: a one-URL extract call reports usage.credits = 0, so this call count — not tavilyCredits — is the actual extraction-volume signal."
                            }
                          },
                          "required": [
                            "wallMs",
                            "totalUsd",
                            "llmUsd",
                            "searchUsd",
                            "searchCalls",
                            "tavilyCredits",
                            "tavilyExtractCalls"
                          ],
                          "additionalProperties": false,
                          "description": "What this single run actually cost and how long it took — counted in code. Search spend is the vendor-reported USD, LLM spend is computed from the rate table."
                        }
                      },
                      "required": [
                        "report",
                        "citations",
                        "sources",
                        "unverified",
                        "status",
                        "warnings",
                        "grounding",
                        "cost"
                      ],
                      "additionalProperties": false
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "depth",
                    "submittedAt",
                    "startedAt",
                    "finishedAt",
                    "queuePosition",
                    "progress",
                    "typicalDurationMs"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "Response for status 404",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "operationId": "researchStatus",
        "x-cli": {
          "command": [
            "research",
            "status"
          ],
          "positional": [
            "jobId"
          ],
          "defaultFormat": "plain",
          "plainField": "result.report",
          "mutating": false
        }
      },
      "delete": {
        "tags": [
          "Research"
        ],
        "summary": "Cancel a research job",
        "description": "Cancels a queued or running job: a queued one never starts, a running one is aborted and its slot freed. Returns `status: 'cancelled'`. Idempotent — a job that is already terminal is returned with its status unchanged. A cancelled job's idempotencyKey is released for a corrected resubmit.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Response for status 200",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "jobId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "jobId",
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "Response for status 404",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "409": {
            "description": "Response for status 409",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "operationId": "researchCancel",
        "x-cli": {
          "command": [
            "research",
            "cancel"
          ],
          "positional": [
            "jobId"
          ],
          "defaultFormat": "plain",
          "mutating": true
        }
      }
    }
  }
}
