{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "How a Slack message becomes committed, deployed work",
    "subtitle": "The lifecycle path end to end, including the two ways it stops",
    "viewBox": [
      1080,
      1700
    ],
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "animation": "none",
    "column_fit": "spread"
  },
  "participants": [
    {
      "id": "human",
      "type": "external",
      "label": "Him, in Slack",
      "sublabel": "reports, approves"
    },
    {
      "id": "hermes",
      "type": "backend",
      "label": "Hermes",
      "sublabel": "answers, narrates"
    },
    {
      "id": "warden",
      "type": "backend",
      "label": "Warden",
      "sublabel": "the ledger, the loop"
    },
    {
      "id": "sideclaw",
      "type": "messagebus",
      "label": "sideclaw",
      "sublabel": "job queue"
    },
    {
      "id": "worker",
      "type": "backend",
      "label": "the worker",
      "sublabel": "in a worktree"
    }
  ],
  "segments": [
    {
      "label": "Report",
      "from": 160,
      "to": 300
    },
    {
      "label": "Investigate — or defer on budget",
      "from": 320,
      "to": 620
    },
    {
      "label": "Gate — case 1/2/4 only",
      "from": 640,
      "to": 900
    },
    {
      "label": "Implement, then review",
      "from": 920,
      "to": 1380
    },
    {
      "label": "Merge, deploy, verify",
      "from": 1400,
      "to": 1620
    }
  ],
  "messages": [
    {
      "from": "human",
      "to": "hermes",
      "y": 190,
      "label": "reports a problem, or an alert fires",
      "variant": "emphasis"
    },
    {
      "from": "hermes",
      "to": "warden",
      "y": 250,
      "label": "warden run — the brief on stdin",
      "note": "hermes-cc.sh is retired. A six-line shim in hermes-agent execs straight into this repo's `scripts/warden` — there is no bridge process left to be the thing that is down when Hermes is down."
    },
    {
      "from": "warden",
      "to": "sideclaw",
      "y": 360,
      "label": "opens the item, dispatches investigate",
      "variant": "emphasis",
      "note": "The item is written to ~/.warden/warden.db before anything is spent. Past MAX_OPEN_INVESTIGATIONS the item stays `new` and waits — overflow is never dropped, only deferred."
    },
    {
      "from": "sideclaw",
      "to": "worker",
      "y": 430,
      "label": "cuts a read-only worktree"
    },
    {
      "from": "worker",
      "to": "sideclaw",
      "y": 520,
      "label": "verdict: nextAction=implement",
      "variant": "return"
    },
    {
      "from": "sideclaw",
      "to": "warden",
      "y": 590,
      "label": "verdict, confidence=high",
      "variant": "return"
    },
    {
      "from": "warden",
      "to": "human",
      "y": 700,
      "label": "approve the diff?",
      "variant": "security",
      "note": "Only the four human-essential cases gate (DESIGN.md): monitoring config, a first deploy target, a third-party issue, reviving a wedged gateway. Everything else in a tier-3 repo runs straight through to implement with no approval at all."
    },
    {
      "from": "human",
      "to": "warden",
      "y": 780,
      "label": "Approve",
      "variant": "dashed",
      "note": "A denial, a timeout, or no case firing at all: the item parks at `needs_human` and waits on the board — the other way this stops. Nothing merges until a human clears it."
    },
    {
      "from": "warden",
      "to": "sideclaw",
      "y": 870,
      "label": "dispatches implement",
      "variant": "emphasis"
    },
    {
      "from": "sideclaw",
      "to": "worker",
      "y": 950,
      "label": "writable worktree, opens draft PR"
    },
    {
      "from": "worker",
      "to": "sideclaw",
      "y": 1040,
      "label": "PR opened",
      "variant": "return"
    },
    {
      "from": "sideclaw",
      "to": "warden",
      "y": 1100,
      "label": "PR ready",
      "variant": "return"
    },
    {
      "from": "warden",
      "to": "sideclaw",
      "y": 1170,
      "label": "dispatches review — a second session"
    },
    {
      "from": "sideclaw",
      "to": "worker",
      "y": 1250,
      "label": "reads the diff, no write access"
    },
    {
      "from": "worker",
      "to": "sideclaw",
      "y": 1320,
      "label": "review verdict: pass",
      "variant": "return"
    },
    {
      "from": "sideclaw",
      "to": "warden",
      "y": 1360,
      "label": "review verdict",
      "variant": "return"
    },
    {
      "from": "warden",
      "to": "hermes",
      "y": 1480,
      "label": "merge, deploy, verify",
      "variant": "emphasis",
      "note": "Merge only if every changed path is inside the repo's approved scope. Deploy runs the repo's own make target. Verify re-reads the live system so `fixed` means observed, not just merged."
    },
    {
      "from": "hermes",
      "to": "human",
      "y": 1560,
      "label": "fixed — card updated in place",
      "variant": "return"
    }
  ]
}
