#!/usr/bin/env bash
# imgcli — upload to and address the image CDN (imgproxy + B2 + Cloudflare).
#
# Secrets resolve through `secrets-run`, the op shim: live biometric `op` on the
# MacBook, the age-encrypted offline cache on the headless mini. Same refs on
# both. Nothing here embeds a hostname, bucket, or credential — this repo is
# public.
#
# Infra side lives in ~/SourceRoot/vps/apps/imgproxy/ (docs/image-cdn.md).

set -euo pipefail

REF_ITEM="op://common/b2-images-write"
REF_BUCKET_ITEM="op://common/backblaze-s3"
# Private layer (image-share, homelab). Resolved lazily inside share/publish
# only, so every other command keeps working on a mini that hasn't cached
# these refs yet.
REF_SHARE_ITEM="op://homelab/image-share"

die() { printf 'imgcli: %s\n' "$*" >&2; exit 1; }

need() { command -v "$1" >/dev/null 2>&1 || die "missing required tool: $1"; }

# --- config -----------------------------------------------------------------
# Resolved once per invocation and exported for the aws CLI.
load_config() {
  need secrets-run
  need aws

  AWS_ACCESS_KEY_ID=$(secrets-run read "$REF_ITEM/B2_KEY_ID")
  AWS_SECRET_ACCESS_KEY=$(secrets-run read "$REF_ITEM/B2_APP_KEY")
  CDN_BASE=$(secrets-run read "$REF_ITEM/CDN_BASE")
  PREFIX=$(secrets-run read "$REF_ITEM/BUCKET_PREFIX")
  BUCKET=$(secrets-run read "$REF_BUCKET_ITEM/BUCKET")
  ENDPOINT=$(secrets-run read "$REF_BUCKET_ITEM/ENDPOINT")
  AWS_DEFAULT_REGION=$(secrets-run read "$REF_BUCKET_ITEM/REGION")
  export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_DEFAULT_REGION

  [ -n "$BUCKET" ] && [ -n "$CDN_BASE" ] || die "config incomplete"
}

s3() { aws s3 "$@" --endpoint-url "$ENDPOINT"; }
s3api() { aws s3api "$@" --endpoint-url "$ENDPOINT"; }

# Strip any leading img/ the caller may have included, so both `blog/x.jpg` and
# `img/blog/x.jpg` address the same object.
norm_key() { printf '%s' "${1#"$PREFIX"}" | sed 's#^/##'; }

# Normalizes an upload/publish prefix argument to the bare enum value the
# image-share service expects (fuji|blog|gen|misc): strips an optional
# leading img/ and trailing slash, defaults to misc. Opaque naming for
# gen/misc now happens server-side (lib/naming.ts), so this is the only
# prefix handling left on the client.
norm_upload_prefix() {
  local p="${1:-misc}"
  p="${p#img/}"
  p="${p%/}"
  [ -n "$p" ] || p="misc"
  case "$p" in
    fuji|blog|gen|misc) printf '%s' "$p" ;;
    *) die "unknown prefix: $p (must be one of: fuji, blog, gen, misc)" ;;
  esac
}

dims_of() {
  # macOS sips; returns "WxH" or empty when not an image sips understands.
  local w h
  w=$(sips -g pixelWidth "$1" 2>/dev/null | awk '/pixelWidth/{print $2}')
  h=$(sips -g pixelHeight "$1" 2>/dev/null | awk '/pixelHeight/{print $2}')
  [ -n "$w" ] && [ -n "$h" ] && printf '%sx%s' "$w" "$h"
}

human() {
  awk -v b="$1" 'BEGIN{
    split("B KB MB GB",u," "); i=1
    while (b>=1024 && i<4) { b/=1024; i++ }
    printf (i==1 ? "%d%s" : "%.1f%s"), b, u[i]
  }'
}

# --- private layer (image-share) --------------------------------------------
# Bearer-auth'd HTTP service on the homelab. Ingests files into a durable
# private copy and, on publish, hands them off to the same B2/imgproxy CDN
# `upload`/`sync` write to directly.

is_valid_publish_prefix() {
  case "$1" in
    fuji|blog|gen|misc) return 0 ;;
    *) return 1 ;;
  esac
}

load_share_config() {
  need secrets-run
  need curl

  SHARE_BASE=$(secrets-run read "$REF_SHARE_ITEM/BASE_URL") \
    || die "could not resolve image-share secrets — add $REF_SHARE_ITEM to dotfiles-private/headless.refs and run 'make secrets-seed'"
  SHARE_SECRET=$(secrets-run read "$REF_SHARE_ITEM/API_SECRET") \
    || die "could not resolve image-share secrets — add $REF_SHARE_ITEM to dotfiles-private/headless.refs and run 'make secrets-seed'"

  [ -n "$SHARE_BASE" ] && [ -n "$SHARE_SECRET" ] || die "image-share config incomplete"
}

# Reads a single field out of a JSON object on stdin. No jq dependency, same
# call shape as the python blocks cmd_info/cmd_ls already use.
json_field() {
  local json="$1" field="$2"
  python3 -c 'import json, sys; d = json.load(sys.stdin); print(d[sys.argv[1]])' "$field" <<<"$json"
}

# POST /api/images — shared by `share` and `publish` (publish always stages
# through the private layer first).
share_ingest() {
  local file="$1" dir="$2"
  local args=(-sS -w '\n%{http_code}' -X POST "${SHARE_BASE}/api/images" \
    -H "Authorization: Bearer ${SHARE_SECRET}" \
    -F "file=@${file}")
  [ -n "$dir" ] && args+=(-F "dir=${dir}")

  local out status body
  out="$(curl "${args[@]}")" || die "image-share ingest request failed (network error)"
  status="${out##*$'\n'}"
  body="${out%$'\n'"${status}"}"
  [ "$status" = "201" ] || die "image-share ingest failed (HTTP $status): $body"
  printf '%s' "$body"
}

# POST /api/publish for a single already-ingested image id.
share_publish() {
  local id="$1" prefix="$2"
  case "$id" in
    '' | *[!0-9]*) die "image-share ingest returned a non-numeric id: $id" ;;
  esac
  local payload
  payload="$(printf '{"imageIds":[%s],"prefix":"%s"}' "$id" "$prefix")"

  local out status body
  out="$(curl -sS -w '\n%{http_code}' -X POST "${SHARE_BASE}/api/publish" \
    -H "Authorization: Bearer ${SHARE_SECRET}" \
    -H "Content-Type: application/json" \
    -d "$payload")" || die "image-share publish request failed (network error)"
  status="${out##*$'\n'}"
  body="${out%$'\n'"${status}"}"
  [ "$status" = "200" ] || die "image-share publish failed (HTTP $status): $body"
  printf '%s' "$body"
}

# Pulls the CDN key for `id` out of a /api/publish response — from `published`
# normally, or from `skipped` when the image was already published before
# (that is success, not an error). Prints a note to stderr in the latter case.
publish_result_key() {
  local body="$1" id="$2"
  ID="$id" python3 -c '
import json, os, sys

d = json.loads(sys.argv[1])
target = os.environ["ID"]

for item in d.get("published", []):
    if str(item.get("id")) == target:
        print(item["key"])
        sys.exit(0)

for item in d.get("skipped", []):
    if str(item.get("id")) == target and item.get("key"):
        print("already published (%s)" % item.get("reason", "skipped"), file=sys.stderr)
        print(item["key"])
        sys.exit(0)

sys.exit(1)
' "$body"
}

# --- commands ---------------------------------------------------------------

cmd_upload() {
  local file="" dest="" name="" copy=0 open=0 json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --copy) copy=1; shift ;;
      --open) open=1; shift ;;
      --json) json=1; shift ;;
      -*) die "unknown flag: $1" ;;
      *) if [ -z "$file" ]; then file="$1"; else dest="$1"; fi; shift ;;
    esac
  done
  [ -n "$file" ] || die "usage: imgcli upload <file> [prefix/] [--name N] [--copy] [--open] [--json]"
  [ -f "$file" ] || die "no such file: $file"

  load_config
  dest="${dest:-misc/}"
  dest="$(norm_key "$dest")"
  case "$dest" in */|"") : ;; *) dest="$dest/" ;; esac

  local base ext
  base="$(basename "$file")"
  ext="${base##*.}"
  if [ -n "$name" ]; then
    base="$name"
  elif is_opaque_prefix "$dest"; then
    base="$(rand_name).${ext}"
  fi

  local key="${dest}${base}"
  local dims; dims="$(dims_of "$file" || true)"

  # Dimensions ride along as object metadata so `ls` can show them without
  # downloading anything.
  local meta=()
  if [ -n "$dims" ]; then
    meta=(--metadata "width=${dims%x*},height=${dims#*x}")
  fi

  s3api put-object \
    --bucket "$BUCKET" \
    --key "${PREFIX}${key}" \
    --body "$file" \
    "${meta[@]}" >/dev/null

  local url="${CDN_BASE}/${key}"
  if [ "$json" = 1 ]; then
    printf '{"key":"%s","url":"%s","dimensions":"%s","bytes":%s}\n' \
      "$key" "$url" "${dims:-}" "$(wc -c <"$file" | tr -d ' ')"
  else
    printf '%s\n' "$url"
    [ -n "$dims" ] && printf '  %s  %s\n' "$dims" "$(human "$(wc -c <"$file" | tr -d ' ')")"
  fi

  [ "$copy" = 1 ] && printf '%s' "$url" | pbcopy && printf '  (copied)\n'
  [ "$open" = 1 ] && open "$url"
  return 0
}

cmd_sync() {
  local dir="" dest="" json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      -*) die "unknown flag: $1" ;;
      *) if [ -z "$dir" ]; then dir="$1"; else dest="$1"; fi; shift ;;
    esac
  done
  [ -n "$dir" ] && [ -n "$dest" ] || die "usage: imgcli sync <dir> <prefix/> [--json]"
  [ -d "$dir" ] || die "no such directory: $dir"

  load_config
  dest="$(norm_key "$dest")"
  case "$dest" in */) : ;; *) dest="$dest/" ;; esac

  # s3 sync skips unchanged files by size+mtime. Metadata (dimensions) is not
  # attached here — sync is for bulk curated exports where `info` can fetch
  # dimensions on demand.
  s3 sync "$dir" "s3://${BUCKET}/${PREFIX}${dest}" --no-progress \
    --exclude '.*' --exclude '*/.*'

  [ "$json" = 1 ] || printf '\nsynced → %s/%s\n' "$CDN_BASE" "${dest%/}"
}

cmd_ls() {
  local dest="" json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      -*) die "unknown flag: $1" ;;
      *) dest="$1"; shift ;;
    esac
  done
  load_config
  dest="$(norm_key "${dest:-}")"

  local out
  out=$(s3api list-objects-v2 --bucket "$BUCKET" --prefix "${PREFIX}${dest}" \
        --query 'Contents[].{k:Key,s:Size,m:LastModified}' --output json 2>/dev/null || echo '[]')
  [ "$out" = "null" ] && out='[]'

  CDN_BASE="$CDN_BASE" PREFIX="$PREFIX" JSON="$json" python3 - "$out" <<'PY'
import sys, json, os
rows = json.loads(sys.argv[1]) or []
base, prefix = os.environ['CDN_BASE'], os.environ['PREFIX']
as_json = os.environ['JSON'] == '1'

def human(b):
    for u in ('B','KB','MB','GB'):
        if b < 1024: return f"{b:.0f}{u}" if u=='B' else f"{b:.1f}{u}"
        b /= 1024
    return f"{b:.1f}TB"

items = []
for r in rows:
    key = r['k'][len(prefix):] if r['k'].startswith(prefix) else r['k']
    if not key or key.endswith('/'):
        continue
    items.append({'key': key, 'bytes': r['s'], 'modified': r['m'],
                  'url': f"{base}/{key}"})

if as_json:
    print(json.dumps(items, indent=2)); sys.exit()

if not items:
    print('(empty)'); sys.exit()

w = max(len(i['key']) for i in items)
print(f"{'KEY'.ljust(w)}  {'SIZE':>8}  MODIFIED")
print('-' * (w + 32))
for i in items:
    print(f"{i['key'].ljust(w)}  {human(i['bytes']):>8}  {i['modified'][:16].replace('T',' ')}")
print(f"\n{len(items)} object(s)   base: {base}/")
PY
}

cmd_info() {
  local key="${1:-}" json="${2:-}"
  [ -n "$key" ] || die "usage: imgcli info <key> [--json]"
  load_config
  key="$(norm_key "$key")"

  local out
  out=$(s3api head-object --bucket "$BUCKET" --key "${PREFIX}${key}" --output json 2>/dev/null) \
    || die "not found: $key"

  CDN_BASE="$CDN_BASE" KEY="$key" JSON="${json:-}" python3 - "$out" <<'PY'
import sys, json, os
d = json.loads(sys.argv[1])
key, base = os.environ['KEY'], os.environ['CDN_BASE']
md = d.get('Metadata', {})
info = {
    'key': key,
    'url': f"{base}/{key}",
    'bytes': d.get('ContentLength'),
    'content_type': d.get('ContentType'),
    'modified': str(d.get('LastModified')),
    'source_dimensions': (f"{md['width']}x{md['height']}" if 'width' in md and 'height' in md else None),
    'renditions': {
        'thumb_400':  f"{base}/rs:fill:400:400/{key}",
        'web_800':    f"{base}/rs:fit:800/{key}",
        'web_1600':   f"{base}/rs:fit:1600/{key}",
        'og_jpg':     f"{base}/rs:fill:1200:630/f:jpg/{key}",
        'original':   f"{base}/{key}",
    },
}
if os.environ['JSON'] == '--json':
    print(json.dumps(info, indent=2)); sys.exit()
print(f"key         {info['key']}")
print(f"url         {info['url']}")
print(f"size        {info['bytes']} bytes  ({info['content_type']})")
print(f"source dim  {info['source_dimensions'] or '(unknown — uploaded outside imgcli)'}")
print(f"modified    {info['modified']}")
print("\nrenditions")
for k, v in info['renditions'].items():
    print(f"  {k:<12} {v}")
PY
}

cmd_url() {
  local key="${1:-}"; shift || true
  [ -n "$key" ] || die "usage: imgcli url <key> [transform ...]  e.g. imgcli url blog/x.jpg rs:fit:800 f:jpg"
  load_config
  key="$(norm_key "$key")"
  local ops=""
  for op in "$@"; do ops="${ops}${op}/"; done
  printf '%s/%s%s\n' "$CDN_BASE" "$ops" "$key"
}

cmd_transforms() {
  cat <<'EOF'
imgproxy processing options — prepend to the key, slash-separated, any order:

  https://<cdn>/rs:fit:800/f:jpg/blog/photo.jpg
                └── options ──┘ └── key ──┘

RESIZE
  rs:fit:W:H        fit inside WxH, preserve aspect (most common)
  rs:fill:W:H       fill WxH exactly, cropping overflow
  rs:fill-down:W:H  like fill but never enlarges
  rs:force:W:H      stretch to exactly WxH, ignoring aspect
  w:400 / h:300     set one dimension only
  s:800:600         shorthand for size
  dpr:2             multiply all dimensions (retina)
  el:1              allow enlarging beyond source resolution

CROP & POSITION
  c:W:H             crop to WxH before resizing
  g:sm              smart gravity (content-aware; use with rs:fill)
  g:no|so|ea|we|ce  north/south/east/west/center
  g:fp:0.5:0.3      focus point, fractions of width/height
  pd:20             pad 20px
  ex:1              extend to requested size if source is smaller
  rot:90            rotate 90/180/270
  t:10              trim border, tolerance 10

FORMAT & QUALITY
  f:jpg|png|webp|avif   force output format
  q:80                  quality 1-100
  mb:100000             cap output at ~N bytes (auto-lowers quality)

EFFECTS
  bl:5              blur, sigma 5
  sh:0.5            sharpen
  bg:255:255:255    background colour for transparency/padding

OTHER
  cb:v2             cache buster — changes the URL, forces a fresh render
  fn:name           filename in Content-Disposition
  att:1             serve as attachment (download)
  sm:1              strip metadata (already the server default)

NOT AVAILABLE — verified 404 against this deployment
  px:N              pixelate — imgproxy Pro only
  pr:name           presets — none configured server-side
  wm:*              watermark — accepted but a no-op, no watermark configured

NOTES
  - Omit all options to get the untouched original.
  - Format is auto-negotiated (AVIF/WebP) from the Accept header unless f: is set.
  - Prefer f:jpg over the @jpg extension form: @jpg is NOT edge-cached by
    Cloudflare (the path stops ending in a recognised extension).
  - EXIF/GPS is stripped from every rendition by default — originals in the
    bucket keep theirs, but nothing served through the CDN exposes location.
  - rs:fit:N bounds the LONGEST side to N; it does not force width.
EOF
}

cmd_share() {
  local file="" dir="" copy=0 json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dir) dir="$2"; shift 2 ;;
      --copy) copy=1; shift ;;
      --json) json=1; shift ;;
      -*) die "unknown flag: $1" ;;
      *) if [ -z "$file" ]; then file="$1"; else die "unexpected argument: $1"; fi; shift ;;
    esac
  done
  [ -n "$file" ] || die "usage: imgcli share <file> [--dir <dir>] [--copy] [--json]"
  [ -f "$file" ] || die "no such file: $file"

  load_share_config

  local body id root relpath adminurl
  body="$(share_ingest "$file" "$dir")"
  id="$(json_field "$body" id)"
  root="$(json_field "$body" root)"
  relpath="$(json_field "$body" relPath)"
  adminurl="$(json_field "$body" adminFileUrl)"

  if [ "$json" = 1 ]; then
    printf '{"id":"%s","root":"%s","relPath":"%s","adminFileUrl":"%s"}\n' \
      "$id" "$root" "$relpath" "$adminurl"
  else
    printf 'id            %s\n' "$id"
    printf 'relPath       %s\n' "$relpath"
    printf 'admin file    %s\n' "$adminurl"
  fi

  [ "$copy" = 1 ] && printf '%s' "$adminurl" | pbcopy && printf '  (copied)\n'
  return 0
}

cmd_publish() {
  local file="" prefix="" dir="" copy=0 open=0 json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dir) dir="$2"; shift 2 ;;
      --copy) copy=1; shift ;;
      --open) open=1; shift ;;
      --json) json=1; shift ;;
      -*) die "unknown flag: $1" ;;
      *) if [ -z "$file" ]; then file="$1"; else prefix="$1"; fi; shift ;;
    esac
  done
  [ -n "$file" ] || die "usage: imgcli publish <file> [prefix/] [--dir <dir>] [--copy] [--open] [--json]"
  [ -f "$file" ] || die "no such file: $file"

  prefix="${prefix:-gen/}"
  prefix="${prefix%/}"
  is_valid_publish_prefix "$prefix" \
    || die "unknown publish prefix: $prefix (must be one of: fuji, blog, gen, misc)"

  load_config
  load_share_config

  local ingest_body id
  ingest_body="$(share_ingest "$file" "$dir")"
  id="$(json_field "$ingest_body" id)"

  local publish_body key
  publish_body="$(share_publish "$id" "$prefix")"
  key="$(publish_result_key "$publish_body" "$id")" \
    || die "image-share publish did not return image $id in published or skipped: $publish_body"
  key="$(norm_key "$key")"

  local url="${CDN_BASE}/${key}"
  local embed_url="${CDN_BASE}/rs:fit:800/f:jpg/${key}"
  local markdown="![](${embed_url})"

  if [ "$json" = 1 ]; then
    printf '{"id":"%s","key":"%s","cdnUrl":"%s","markdown":"%s","renditions":{"thumb_400":"%s","web_800":"%s","web_1600":"%s","og_jpg":"%s","original":"%s"}}\n' \
      "$id" "$key" "$url" "$markdown" \
      "${CDN_BASE}/rs:fill:400:400/${key}" \
      "${CDN_BASE}/rs:fit:800/${key}" \
      "${CDN_BASE}/rs:fit:1600/${key}" \
      "${CDN_BASE}/rs:fill:1200:630/f:jpg/${key}" \
      "$url"
  else
    printf 'key         %s\n' "$key"
    printf 'cdnUrl      %s\n' "$url"
    printf '\n%s\n' "$markdown"
  fi

  [ "$copy" = 1 ] && printf '%s' "$url" | pbcopy && printf '  (copied)\n'
  [ "$open" = 1 ] && open "$url"
  return 0
}

usage() {
  cat <<'EOF'
imgcli — image CDN upload and addressing, plus the private image-share layer

  imgcli upload  <file> [prefix/] [--name N] [--copy] [--open] [--json]
  imgcli sync    <dir> <prefix/> [--json]
  imgcli ls      [prefix/] [--json]
  imgcli info    <key> [--json]
  imgcli url     <key> [transform ...]
  imgcli transforms
  imgcli share   <file> [--dir <dir>] [--copy] [--json]
  imgcli publish <file> [prefix/] [--dir <dir>] [--copy] [--open] [--json]

PREFIXES (upload, sync, publish)
  fuji/   curated camera exports   — readable names kept
  blog/   article images           — readable names kept
  gen/    generated / ad-hoc       — random names auto-assigned  (publish default)
  misc/   everything else          — random names auto-assigned  (upload default)

Keys are given without the bucket's img/ prefix; `blog/x.jpg` and
`img/blog/x.jpg` both work. Uploads cannot delete: the credential has no
deleteFiles capability by design.

PRIVATE LAYER
  share    ingests a file into the private image-share service on the
           homelab (durable copy, shareable later via token pages).
  publish  ingests, then publishes to the public CDN — for generated or
           final images headed for notes/articles. Always lands in the
           private layer first.

  Both need op://homelab/image-share/{BASE_URL,API_SECRET}; on the headless
  mini these must be seeded first (dotfiles-private/headless.refs +
  `make secrets-seed`).
EOF
}

case "${1:-}" in
  upload)     shift; cmd_upload "$@" ;;
  sync)       shift; cmd_sync "$@" ;;
  ls)         shift; cmd_ls "$@" ;;
  info)       shift; cmd_info "$@" ;;
  url)        shift; cmd_url "$@" ;;
  transforms) cmd_transforms ;;
  share)      shift; cmd_share "$@" ;;
  publish)    shift; cmd_publish "$@" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $1 (try --help)" ;;
esac
