#!/usr/bin/env bash
# imgcli — the personal image stack: generate, upload, address.
#
#   gen       prompt -> local file via the image-gateway (VPS, tailnet-only);
#             --public / --private hand each result on to one of the two lanes
#   upload    local file -> public CDN: straight to B2 img/, served by imgproxy
#             behind Cloudflare (unsigned URLs — an opaque key is the access control)
#   private   local file -> B2 private/ + a time-limited presigned URL. imgproxy
#             is locked to img/, so private/ is only ever reachable by presign.
#
# One B2 bucket, two prefixes, one key per scope (all in 1Password, resolved
# through `secrets-run` — live biometric `op` on the MacBook, the age-encrypted
# offline cache on the headless mini; same refs on both). Nothing here embeds a
# hostname, bucket, or credential — this repo is public.
#
#   op://common/b2-images-write    img/ write, no delete      upload, sync, ls, info, url
#   op://common/b2-images-private  private/ read/write/list   private, private-url, private-ls
#   op://common/b2-images-admin    img/ incl. deleteFiles     rm only — MacBook-only by design:
#                                  deliberately NOT in the mini's headless cache
#   op://common/backblaze-s3       bucket coordinates         every B2 command
#   op://vps/image-gateway         gateway BASE_URL/API_SECRET   gen
#
# Infra side lives in ~/SourceRoot/vps/apps/imgproxy/ (docs/image-cdn.md);
# generation in ~/SourceRoot/image-gateway/gateway/.

set -euo pipefail

REF_ITEM="op://common/b2-images-write"
REF_BUCKET_ITEM="op://common/backblaze-s3"
# Resolved lazily inside the private commands / `rm` only, so every other
# command keeps working on a mini that hasn't cached these refs.
REF_PRIVATE_ITEM="op://common/b2-images-private"
REF_ADMIN_ITEM="op://common/b2-images-admin"
# Generation (image-gateway, VPS, tailnet-only). Resolved lazily inside `gen`
# only, same reasoning.
REF_GEN_ITEM="op://vps/image-gateway"
GEN_DIR="${HOME}/Pictures/imgcli"

PRIVATE_PREFIX="private/"
MAX_BYTES=52428800          # 50 MB
MAX_PIXELS=100000000        # 100 MP
MAX_PRESIGN_SECONDS=604800  # 7 days, the SigV4 maximum

die() { printf 'imgcli: %s\n' "$*" >&2; exit 1; }

need() { command -v "$1" >/dev/null 2>&1 || die "missing required tool: $1"; }

# --- config -----------------------------------------------------------------
# Resolved once per invocation and exported for the aws CLI. Bucket coordinates
# are shared; each lane then activates its own key with `use_key`.
load_coords() {
  need secrets-run
  need aws
  need python3

  BUCKET=$(secrets-run read "$REF_BUCKET_ITEM/BUCKET")
  ENDPOINT=$(secrets-run read "$REF_BUCKET_ITEM/ENDPOINT")
  AWS_DEFAULT_REGION=$(secrets-run read "$REF_BUCKET_ITEM/REGION")
  export AWS_DEFAULT_REGION

  [ -n "$BUCKET" ] && [ -n "$ENDPOINT" ] || die "config incomplete"
}

use_key() {
  AWS_ACCESS_KEY_ID="$1"
  AWS_SECRET_ACCESS_KEY="$2"
  export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY
}

# Public lane: the images-write key, left active.
load_config() {
  load_coords

  WRITE_KEY_ID=$(secrets-run read "$REF_ITEM/B2_KEY_ID")
  WRITE_APP_KEY=$(secrets-run read "$REF_ITEM/B2_APP_KEY")
  CDN_BASE=$(secrets-run read "$REF_ITEM/CDN_BASE")
  PREFIX=$(secrets-run read "$REF_ITEM/BUCKET_PREFIX")

  [ -n "$CDN_BASE" ] && [ -n "$PREFIX" ] && [ -n "$WRITE_KEY_ID" ] && [ -n "$WRITE_APP_KEY" ] \
    || die "config incomplete"
  use_key "$WRITE_KEY_ID" "$WRITE_APP_KEY"
}

# Private lane: the images-private key, left active.
load_private_config() {
  load_coords

  PRIV_KEY_ID=$(secrets-run read "$REF_PRIVATE_ITEM/B2_KEY_ID") \
    || die "could not resolve $REF_PRIVATE_ITEM — add it to dotfiles-private/headless.refs and run 'make secrets-seed'"
  PRIV_APP_KEY=$(secrets-run read "$REF_PRIVATE_ITEM/B2_APP_KEY") \
    || die "could not resolve $REF_PRIVATE_ITEM — add it to dotfiles-private/headless.refs and run 'make secrets-seed'"

  [ -n "$PRIV_KEY_ID" ] && [ -n "$PRIV_APP_KEY" ] || die "private key config incomplete"
  use_key "$PRIV_KEY_ID" "$PRIV_APP_KEY"
}

# Delete lane: the only credential that can remove objects. Not seeded into the
# mini's headless cache on purpose — a headless agent must not be able to delete.
load_admin_key() {
  load_coords
  ADMIN_KEY_ID=$(secrets-run read "$REF_ADMIN_ITEM/B2_KEY_ID" 2>/dev/null) \
    || die "rm is MacBook-only: $REF_ADMIN_ITEM resolves only where live biometric op exists"
  ADMIN_APP_KEY=$(secrets-run read "$REF_ADMIN_ITEM/B2_APP_KEY" 2>/dev/null) \
    || die "rm is MacBook-only: $REF_ADMIN_ITEM resolves only where live biometric op exists"

  [ -n "$ADMIN_KEY_ID" ] && [ -n "$ADMIN_APP_KEY" ] \
    || die "rm is MacBook-only: $REF_ADMIN_ITEM resolves only where live biometric op exists"
  use_key "$ADMIN_KEY_ID" "$ADMIN_APP_KEY"
}

s3() { aws s3 "$@" --endpoint-url "$ENDPOINT"; }
s3api() { aws s3api "$@" --endpoint-url "$ENDPOINT"; }

# Strip any leading img/ the caller may have included, so both `blog/x.jpg` and
# `img/blog/x.jpg` address the same object.
norm_key() { printf '%s' "${1#"$PREFIX"}" | sed 's#^/##'; }

# Same for the private lane: `2026/10/x.png` and `private/2026/10/x.png`.
norm_private_key() { printf '%s' "${1#/}" | sed "s#^${PRIVATE_PREFIX}##"; }

# Keys end up inside an object path — refuse anything that could climb out of it.
check_key() {
  case "$1" in
    ''|*..*|*[[:cntrl:]]*) die "invalid key: ${1:-(empty)}" ;;
  esac
}

# Normalizes an upload prefix argument to the bare enum value
# (fuji|blog|gen|misc): strips an optional leading img/ and trailing slash,
# defaults to misc.
norm_upload_prefix() {
  local p="${1:-misc}"
  p="${p#img/}"
  p="${p%/}"
  [ -n "$p" ] || p="misc"
  case "$p" in
    fuji|blog|gen|misc) printf '%s' "$p" ;;
    *) die "unknown prefix: $p (must be one of: fuji, blog, gen, misc)" ;;
  esac
}

dims_of() {
  # macOS sips; returns "WxH" or empty when not an image sips understands.
  local w h
  w=$(sips -g pixelWidth "$1" 2>/dev/null | awk '/pixelWidth/{print $2}')
  h=$(sips -g pixelHeight "$1" 2>/dev/null | awk '/pixelHeight/{print $2}')
  [ -n "$w" ] && [ -n "$h" ] && printf '%sx%s' "$w" "$h"
}

human() {
  awk -v b="$1" 'BEGIN{
    split("B KB MB GB",u," "); i=1
    while (b>=1024 && i<4) { b/=1024; i++ }
    printf (i==1 ? "%d%s" : "%.1f%s"), b, u[i]
  }'
}

# 16 chars of [a-z0-9] — the unguessable object name.
random_name() {
  python3 -c 'import secrets, string; print("".join(secrets.choice(string.ascii_lowercase + string.digits) for _ in range(16)))'
}

# Source guard shared by `upload` and `private`: extension allow-list (also
# fixes Content-Type), <= 50 MB, <= 100 MP. `name` overrides the filename the
# extension and (for fuji/blog) the object stem are taken from. Sets SRC_STEM,
# SRC_EXT (with dot, original case), SRC_CT, SRC_BYTES, SRC_DIMS ("WxH" or empty).
check_source() {
  local file="$1" name="$2" base ext lower
  [ -f "$file" ] || die "no such file: $file"

  # The extension (and so Content-Type) always comes from the real file;
  # `name` may rename the stem but never change the type.
  base="${file##*/}"
  case "$base" in
    *.*) ext=".${base##*.}" ;;
    *) ext="" ;;
  esac
  if [ -n "$name" ]; then
    name="${name##*/}"
    case "$name" in
      *.*) [ "$(printf '%s' "${name##*.}" | tr '[:upper:]' '[:lower:]')" = "$(printf '%s' "${ext#.}" | tr '[:upper:]' '[:lower:]')" ] \
        || die "--name extension \".${name##*.}\" does not match the file's \"$ext\""
        base="${name%.*}$ext" ;;
      *) base="$name$ext" ;;
    esac
  fi
  lower="$(printf '%s' "${ext#.}" | tr '[:upper:]' '[:lower:]')"
  case "$lower" in
    jpg|jpeg) SRC_CT="image/jpeg" ;;
    png) SRC_CT="image/png" ;;
    webp) SRC_CT="image/webp" ;;
    avif) SRC_CT="image/avif" ;;
    heic) SRC_CT="image/heic" ;;
    raf) SRC_CT="application/octet-stream" ;;
    *) die "unsupported file extension \"${lower:-(none)}\" — allowed: avif, heic, jpeg, jpg, png, raf, webp" ;;
  esac
  SRC_STEM="${base%"$ext"}"
  SRC_EXT="$ext"

  SRC_BYTES="$(wc -c <"$file" | tr -d ' ')"
  [ "$SRC_BYTES" -le "$MAX_BYTES" ] || die "file too large ($SRC_BYTES bytes) — max $MAX_BYTES bytes (50 MB)"

  SRC_DIMS="$(dims_of "$file" || true)"
  if [ -n "$SRC_DIMS" ]; then
    local w="${SRC_DIMS%x*}" h="${SRC_DIMS#*x}"
    [ $((w * h)) -le "$MAX_PIXELS" ] || die "image too large (${SRC_DIMS}) — max 100 MP"
  fi
}

# fuji/ and blog/ keep their (sanitized) filename — a browsable gallery. gen/
# and misc/ get a random name: the CDN serves unsigned URLs, so an unguessable
# key IS the access control.
object_filename() {
  local stem
  case "$1" in
    gen|misc) printf '%s%s' "$(random_name)" "$SRC_EXT" ;;
    *)
      stem="$(printf '%s' "$SRC_STEM" | sed -E 's/[^a-zA-Z0-9_-]+/_/g')"
      printf '%s%s' "${stem:-upload}" "$SRC_EXT"
      ;;
  esac
}

# Writes one object with its Content-Type and, when sips could read them, the
# source dimensions as `width`/`height` object metadata (what `info` reads).
# Needs check_source to have run for this file.
put_object() {
  local file="$1" key="$2"
  local args=(--no-progress --only-show-errors --content-type "$SRC_CT")
  [ -z "$SRC_DIMS" ] || args+=(--metadata "width=${SRC_DIMS%x*},height=${SRC_DIMS#*x}")
  s3 cp "$file" "s3://${BUCKET}/${key}" "${args[@]}"
}

# The one upload path for the public CDN — `upload` and `gen --public` both go
# through here. Needs load_config. Skips (never overwrites) an existing key.
# Sets U_UPLOADED (true|false), U_KEY (without img/), U_URL, U_DIMS, U_BYTES.
upload_object() {
  local file="$1" prefix="$2" name="$3" filename
  check_source "$file" "$name"
  filename="$(object_filename "$prefix")"

  U_KEY="${prefix}/${filename}"
  U_URL="${CDN_BASE}/${U_KEY}"
  U_DIMS="$SRC_DIMS"
  U_BYTES="$SRC_BYTES"

  # A missing key under a prefix-scoped B2 key answers 403, not 404, so any
  # head failure counts as "absent"; a real permission problem surfaces on put.
  if s3api head-object --bucket "$BUCKET" --key "${PREFIX}${U_KEY}" >/dev/null 2>&1; then
    U_UPLOADED=false
    return 0
  fi
  put_object "$file" "${PREFIX}${U_KEY}"
  U_UPLOADED=true
}

# --- private lane (B2 private/) ----------------------------------------------
# Same bucket, a prefix imgproxy cannot see. Objects are reachable only through
# S3 presigned GET URLs, which expire (SigV4 caps that at 7 days).

# "7d" | "12h" | "30m" | "90s" | "1w" | plain seconds -> EXPIRES_SECS.
parse_expires() {
  local v="${1:-7d}" n u=s mult
  case "$v" in
    *[smhdw]) u="${v: -1}"; n="${v%?}" ;;
    *) n="$v" ;;
  esac
  case "$n" in
    ''|*[!0-9]*) die "bad --expires: $v (use e.g. 90s, 30m, 12h, 7d, 1w, or plain seconds)" ;;
  esac
  [ "${#n}" -le 9 ] || die "bad --expires: $v (too large)"
  case "$u" in
    s) mult=1 ;;
    m) mult=60 ;;
    h) mult=3600 ;;
    d) mult=86400 ;;
    w) mult=604800 ;;
  esac
  EXPIRES_SECS=$((10#$n * mult))
  [ "$EXPIRES_SECS" -ge 1 ] || die "bad --expires: $v (must be positive)"
  [ "$EXPIRES_SECS" -le "$MAX_PRESIGN_SECONDS" ] \
    || die "--expires $v exceeds the 7 day presign maximum (${MAX_PRESIGN_SECONDS}s, the SigV4 limit)"
}

# Presigned GET for a full private key. Sets P_URL, P_EXPIRES_AT (UTC ISO).
presign_url() {
  P_URL="$(aws s3 presign "s3://${BUCKET}/$1" --expires-in "$EXPIRES_SECS" --endpoint-url "$ENDPOINT")" \
    || die "presign failed"
  P_EXPIRES_AT="$(python3 -c '
import datetime, sys
t = datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(seconds=int(sys.argv[1]))
print(t.strftime("%Y-%m-%dT%H:%M:%SZ"))
' "$EXPIRES_SECS")"
}

# Puts a file to private/<yyyy>/<mm>/<random>.<ext> and presigns it. Needs
# load_private_config + parse_expires. Sets P_KEY (without private/), P_URL,
# P_EXPIRES_AT, P_BYTES.
private_put() {
  local file="$1" full
  check_source "$file" ""
  P_KEY="$(date -u +%Y/%m)/$(random_name)${SRC_EXT}"
  P_BYTES="$SRC_BYTES"
  full="${PRIVATE_PREFIX}${P_KEY}"
  put_object "$file" "$full"
  presign_url "$full"
}

# Reads a single field out of a JSON object on stdin. No jq dependency, same
# call shape as the python blocks cmd_info/cmd_ls already use.
json_field() {
  local json="$1" field="$2"
  python3 -c 'import json, sys; d = json.load(sys.stdin); print(d[sys.argv[1]])' "$field" <<<"$json"
}

# --- generation (image-gateway) ----------------------------------------------
# Stateless bearer-auth'd gateway on the VPS wrapping gpt-image-2.5 (flare /
# sunburst). No model is sent: the gateway auto-routes by quality/endpoint. `gen`
# is the agent lane into it: generate (or edit / plan-then-generate) and write
# the PNGs under ~/Pictures/imgcli/. --public uploads each one to the CDN
# through the same path as `upload`; --private puts it under private/ and
# presigns it.

load_gen_config() {
  need secrets-run
  need curl
  need python3

  GEN_BASE=$(secrets-run read "$REF_GEN_ITEM/BASE_URL") \
    || die "could not resolve image-gateway secrets — add $REF_GEN_ITEM to dotfiles-private/headless.refs and run 'make secrets-seed'"
  GEN_SECRET=$(secrets-run read "$REF_GEN_ITEM/API_SECRET") \
    || die "could not resolve image-gateway secrets — add $REF_GEN_ITEM to dotfiles-private/headless.refs and run 'make secrets-seed'"

  [ -n "$GEN_BASE" ] && [ -n "$GEN_SECRET" ] || die "image-gateway config incomplete"
  GEN_BASE="${GEN_BASE%/}"
}

# Runs one gateway request, writing the response body to `$out_file` (bodies
# carry base64 images — megabytes, never a shell variable). Prints nothing;
# dies on a network error or a non-200 with the gateway's `error.message`.
gen_request() {
  local path="$1" out_file="$2"; shift 2
  local status
  status="$(curl -sS -o "$out_file" -w '%{http_code}' --connect-timeout 5 --max-time 300 \
    -X POST "${GEN_BASE}${path}" \
    -H "@${GEN_TMP}/hdr" "$@")" \
    || die "image-gateway request failed (network error — the gateway is tailnet-only)"
  [ "$status" = "200" ] && return 0
  local message
  message="$(python3 -c '
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    print(d.get("error", {}).get("message") or json.dumps(d))
except Exception:
    print(open(sys.argv[1], errors="replace").read()[:400])
' "$out_file")"
  die "image-gateway ${path} failed (HTTP $status): $message"
}

cmd_gen() {
  local prompt="" size="" n="" quality="" background="" edit="" enhance=0 public=0 private=0 prefix="gen" expires="" copy=0 open=0 json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --size) size="$2"; shift 2 ;;
      --n) n="$2"; shift 2 ;;
      --quality) quality="$2"; shift 2 ;;
      --background) background="$2"; shift 2 ;;
      --edit) edit="$2"; shift 2 ;;
      --enhance) enhance=1; shift ;;
      --public) public=1; shift ;;
      --prefix) prefix="$2"; shift 2 ;;
      --private) private=1; shift ;;
      --expires) expires="$2"; shift 2 ;;
      --copy) copy=1; shift ;;
      --open) open=1; shift ;;
      --json) json=1; shift ;;
      -*) die "unknown flag: $1" ;;
      *) if [ -z "$prompt" ]; then prompt="$1"; else die "unexpected argument: $1"; fi; shift ;;
    esac
  done
  [ -n "$prompt" ] || die "usage: imgcli gen \"<prompt>\" [--size WxH|auto] [--n 1-10] [--quality low|medium|high|xhigh|max|auto] [--background transparent|opaque|auto] [--edit <file>] [--enhance] [--public [--prefix fuji|blog|gen|misc]] [--private [--expires <dur>]] [--copy] [--open] [--json]"
  [ -z "$edit" ] || [ -f "$edit" ] || die "no such file: $edit"
  local mime=""
  if [ -n "$edit" ]; then
    case "${edit##*.}" in
      png|PNG) mime=image/png ;;
      jpg|jpeg|JPG|JPEG) mime=image/jpeg ;;
      webp|WEBP) mime=image/webp ;;
      *) die "reference image must be png, jpeg or webp: $edit" ;;
    esac
  fi
  case "$size" in
    ''|auto) : ;;
    *) case "$size" in
         [0-9][0-9]*x[0-9][0-9]*) : ;;
         *) die "size must be WxH (e.g. 1024x1024) or auto: $size" ;;
       esac ;;
  esac
  case "$n" in
    ''|[1-9]|10) : ;;
    *) die "--n must be 1-10: $n" ;;
  esac
  case "$quality" in
    ''|low|medium|high|xhigh|max|auto) : ;;
    *) die "unknown quality: $quality (must be one of: low, medium, high, xhigh, max, auto)" ;;
  esac
  case "$background" in
    ''|transparent|opaque|auto) : ;;
    *) die "unknown background: $background (must be one of: transparent, opaque, auto)" ;;
  esac
  [ "$public" = 1 ] && [ "$private" = 1 ] && die "--public and --private are mutually exclusive"
  [ -z "$expires" ] || [ "$private" = 1 ] || die "--expires needs --private"
  prefix="$(norm_upload_prefix "$prefix")"
  [ "$private" = 1 ] && parse_expires "$expires"

  # Not `local`: the EXIT trap runs after the function's scope is gone.
  GEN_TMP="$(mktemp -d)"
  trap 'rm -rf "$GEN_TMP"' EXIT
  local tmp="$GEN_TMP"

  load_gen_config
  [ "$public" = 1 ] && load_config
  [ "$private" = 1 ] && load_private_config
  # The bearer reaches curl through a file, never argv — `ps` shows argv for
  # the whole request, and a gen call runs 10-300 s.
  ( umask 077; printf 'Authorization: Bearer %s\n' "$GEN_SECRET" >"$tmp/hdr" )

  # --enhance: POST /enhance turns the brief into a playbook-conditioned Plan
  # (prompt + derived settings + policy warnings) before any generation is
  # paid for. Explicit flags win over the plan's derived settings; a `hard`
  # warning is a wall the studio would refuse at, so the CLI refuses too.
  local plan_json=""
  if [ "$enhance" = 1 ]; then
    local plan_req="$tmp/plan-req.json" plan_res="$tmp/plan-res.json"
    PROMPT="$prompt" HAS_REF="$([ -n "$edit" ] && printf true || printf false)" python3 -c '
import json, os, sys
json.dump({"brief": os.environ["PROMPT"], "has_references": os.environ["HAS_REF"] == "true"}, open(sys.argv[1], "w"))
' "$plan_req"
    gen_request /enhance "$plan_res" -H "Content-Type: application/json" --data-binary "@$plan_req"
    plan_json="$(JSON="$json" python3 -c '
import json, os, sys
d = json.load(open(sys.argv[1]))
s = d["settings"]
hard = [w for w in d.get("warnings", []) if w.get("severity") == "hard"]
if hard:
    print("plan refused (hard policy wall): " + "; ".join(w["message"] for w in hard))
    sys.exit(1)
if os.environ["JSON"] != "1":
    for a in d.get("assumptions", []):
        print("plan assumption: " + a, file=sys.stderr)
    for w in d.get("warnings", []):
        print("plan warning [%s]: %s" % (w["severity"], w["message"]), file=sys.stderr)
print(json.dumps({
    "prompt": d["prompt"], "size": s["size"], "quality": s["quality"], "n": s["n"],
    "background": s["background"],
    "estimated_cost_usd": d["estimated_cost"]["total_usd"],
    "assumptions": d.get("assumptions", []), "warnings": d.get("warnings", []),
    "playbook_version": d["playbook_version"], "enhance_model": d["enhance_model"],
}))
' "$plan_res")" || die "$plan_json"
    prompt="$(json_field "$plan_json" prompt)"
    [ -n "$size" ] || size="$(json_field "$plan_json" size)"
    [ -n "$quality" ] || quality="$(json_field "$plan_json" quality)"
    [ -n "$n" ] || n="$(json_field "$plan_json" n)"
    # The plan's prompt is written to match its background ("transparent
    # background" wording only when it chose transparent). Dropping the
    # background while sending that prompt is the painted-checkerboard bug.
    [ -n "$background" ] || background="$(json_field "$plan_json" background)"
  fi

  # Generate (JSON) or edit (multipart, `image[]` + the same fields).
  local res="$tmp/gen-res.json"
  if [ -n "$edit" ]; then
    local args=(-F "image[]=@${edit};type=${mime}" --form-string "prompt=${prompt}")
    [ -n "$size" ] && args+=(--form-string "size=${size}")
    [ -n "$n" ] && args+=(--form-string "n=${n}")
    [ -n "$quality" ] && args+=(--form-string "quality=${quality}")
    [ -n "$background" ] && args+=(--form-string "background=${background}")
    gen_request /edit "$res" "${args[@]}"
  else
    local req="$tmp/gen-req.json"
    PROMPT="$prompt" SIZE="$size" N="$n" QUALITY="$quality" BACKGROUND="$background" python3 -c '
import json, os, sys
body = {"prompt": os.environ["PROMPT"]}
if os.environ["SIZE"]: body["size"] = os.environ["SIZE"]
if os.environ["N"]: body["n"] = int(os.environ["N"])
if os.environ["QUALITY"]: body["quality"] = os.environ["QUALITY"]
if os.environ["BACKGROUND"]: body["background"] = os.environ["BACKGROUND"]
json.dump(body, open(sys.argv[1], "w"))
' "$req"
    gen_request /generate "$res" -H "Content-Type: application/json" --data-binary "@$req"
  fi

  # Decode every image to disk. Prints one header line (tab-separated
  # metadata) followed by one absolute file path per image.
  mkdir -p "$GEN_DIR"
  local meta files=()
  {
    read -r meta
    while IFS= read -r line; do files+=("$line"); done
  } < <(OUT_DIR="$GEN_DIR" python3 -c '
import base64, json, os, sys, time
d = json.load(open(sys.argv[1]))
stamp = time.strftime("%Y%m%d-%H%M%S")
short = d["id"].split("-")[0]
cost = d.get("cost", {}).get("usd")
print("\t".join([d["id"], d["model"], str(d["size"]), str(d["quality"]),
                 "" if cost is None else f"{cost:.4f}", str(d["latency_ms"])]))
for i, img in enumerate(d["images"], 1):
    path = os.path.join(os.environ["OUT_DIR"], "gen-%s-%s-%d.%s" % (stamp, short, i, img["format"]))
    with open(path, "wb") as f:
        f.write(base64.b64decode(img["b64_json"]))
    print(path)
' "$res")
  [ ${#files[@]} -gt 0 ] || die "gateway returned no images"
  local gen_id model gsize gquality cost latency
  IFS=$'\t' read -r gen_id model gsize gquality cost latency <<<"$meta"

  # --public: through the same path as `upload`. --private: put under private/
  # and presign. Neither: the file stays local.
  local results="$tmp/results.jsonl" file url="" target
  : >"$results"
  for file in "${files[@]}"; do
    if [ "$public" = 1 ]; then
      upload_object "$file" "$prefix" ""
      url="$U_URL"
      FILE="$file" ID="$gen_id" KEY="$U_KEY" URL="$U_URL" EMBED="${CDN_BASE}/rs:fit:800/f:jpg/${U_KEY}" python3 -c '
import json, os
e = os.environ
print(json.dumps({"file": e["FILE"], "id": e["ID"], "key": e["KEY"], "cdnUrl": e["URL"], "markdown": "![](%s)" % e["EMBED"]}))
' >>"$results"
    elif [ "$private" = 1 ]; then
      private_put "$file"
      url="$P_URL"
      FILE="$file" ID="$gen_id" KEY="$P_KEY" URL="$P_URL" EXPIRES_AT="$P_EXPIRES_AT" python3 -c '
import json, os
e = os.environ
print(json.dumps({"file": e["FILE"], "id": e["ID"], "key": e["KEY"], "url": e["URL"], "expiresAt": e["EXPIRES_AT"]}))
' >>"$results"
    else
      FILE="$file" ID="$gen_id" python3 -c '
import json, os
print(json.dumps({"file": os.environ["FILE"], "id": os.environ["ID"]}))
' >>"$results"
    fi
  done

  if [ "$json" = 1 ]; then
    GEN_ID="$gen_id" MODEL="$model" SIZE="$gsize" QUALITY="$gquality" COST="$cost" LATENCY="$latency" \
      PUBLIC="$public" PRIVATE="$private" PLAN="$plan_json" python3 -c '
import json, os, sys
e = os.environ
out = {"id": e["GEN_ID"], "model": e["MODEL"], "size": e["SIZE"], "quality": e["QUALITY"],
       "cost_usd": float(e["COST"]) if e["COST"] else None, "latency_ms": int(e["LATENCY"]),
       "public": e["PUBLIC"] == "1", "private": e["PRIVATE"] == "1",
       "images": [json.loads(l) for l in open(sys.argv[1]) if l.strip()]}
if e["PLAN"]:
    out["plan"] = json.loads(e["PLAN"])
print(json.dumps(out))
' "$results"
  else
    printf 'generated  %s image(s)  %s  %s  quality=%s  $%s  %sms\n' \
      "${#files[@]}" "$model" "$gsize" "$gquality" "${cost:-?}" "$latency"
    python3 - "$results" <<'PY'
import json, sys
for line in open(sys.argv[1]):
    r = json.loads(line)
    print(f"  {r['file']}")
    if "cdnUrl" in r:
        print(f"    key {r['key']}")
        print(f"    {r['cdnUrl']}")
        print(f"    {r['markdown']}")
    elif "url" in r:
        print(f"    key {r['key']}  (expires {r['expiresAt']})")
        print(f"    {r['url']}")
PY
  fi

  # --copy / --open act on the last result: its URL, or the local file.
  target="${url:-${files[${#files[@]} - 1]}}"
  [ "$copy" = 1 ] && printf '%s' "$target" | pbcopy && printf '  (copied)\n'
  [ "$open" = 1 ] && open "$target"
  return 0
}

# --- commands ---------------------------------------------------------------

cmd_upload() {
  local file="" dest="" name="" copy=0 open=0 json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --copy) copy=1; shift ;;
      --open) open=1; shift ;;
      --json) json=1; shift ;;
      -*) die "unknown flag: $1" ;;
      *) if [ -z "$file" ]; then file="$1"; else dest="$1"; fi; shift ;;
    esac
  done
  [ -n "$file" ] || die "usage: imgcli upload <file> [prefix/] [--name N] [--copy] [--open] [--json]"
  [ -f "$file" ] || die "no such file: $file"

  local prefix; prefix="$(norm_upload_prefix "$dest")"
  load_config
  upload_object "$file" "$prefix" "$name"

  if [ "$json" = 1 ]; then
    if [ "$U_UPLOADED" = true ]; then
      printf '{"uploaded":true,"key":"%s","url":"%s","dimensions":"%s","bytes":%s}\n' \
        "$U_KEY" "$U_URL" "$U_DIMS" "$U_BYTES"
    else
      printf '{"uploaded":false,"key":"%s","url":"%s","reason":"key already exists"}\n' "$U_KEY" "$U_URL"
    fi
  else
    if [ "$U_UPLOADED" = true ]; then
      printf 'uploaded  %s\n' "$U_URL"
      [ -z "$U_DIMS" ] || printf '  %s  %s\n' "$U_DIMS" "$(human "$U_BYTES")"
    else
      printf 'skipped, key exists  %s\n' "$U_URL"
    fi
  fi

  [ "$copy" = 1 ] && printf '%s' "$U_URL" | pbcopy && printf '  (copied)\n'
  [ "$open" = 1 ] && open "$U_URL"
  return 0
}

cmd_sync() {
  local dir="" dest="" json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      -*) die "unknown flag: $1" ;;
      *) if [ -z "$dir" ]; then dir="$1"; else dest="$1"; fi; shift ;;
    esac
  done
  [ -n "$dir" ] && [ -n "$dest" ] || die "usage: imgcli sync <dir> <prefix/> [--json]"
  [ -d "$dir" ] || die "no such directory: $dir"

  load_config
  dest="$(norm_key "$dest")"
  case "$dest" in */) : ;; *) dest="$dest/" ;; esac

  # s3 sync skips unchanged files by size+mtime. Metadata (dimensions) is not
  # attached here — sync is for bulk curated exports where `info` can fetch
  # dimensions on demand.
  s3 sync "$dir" "s3://${BUCKET}/${PREFIX}${dest}" --no-progress \
    --exclude '.*' --exclude '*/.*'

  [ "$json" = 1 ] || printf '\nsynced → %s/%s\n' "$CDN_BASE" "${dest%/}"
}

cmd_ls() {
  local dest="" json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      -*) die "unknown flag: $1" ;;
      *) dest="$1"; shift ;;
    esac
  done
  load_config
  dest="$(norm_key "${dest:-}")"

  local out
  out=$(s3api list-objects-v2 --bucket "$BUCKET" --prefix "${PREFIX}${dest}" \
        --query 'Contents[].{k:Key,s:Size,m:LastModified}' --output json 2>/dev/null || echo '[]')
  [ "$out" = "null" ] && out='[]'

  CDN_BASE="$CDN_BASE" PREFIX="$PREFIX" JSON="$json" python3 - "$out" <<'PY'
import sys, json, os
rows = json.loads(sys.argv[1]) or []
base, prefix = os.environ['CDN_BASE'], os.environ['PREFIX']
as_json = os.environ['JSON'] == '1'

def human(b):
    for u in ('B','KB','MB','GB'):
        if b < 1024: return f"{b:.0f}{u}" if u=='B' else f"{b:.1f}{u}"
        b /= 1024
    return f"{b:.1f}TB"

items = []
for r in rows:
    key = r['k'][len(prefix):] if r['k'].startswith(prefix) else r['k']
    if not key or key.endswith('/'):
        continue
    items.append({'key': key, 'bytes': r['s'], 'modified': r['m'],
                  'url': f"{base}/{key}"})

if as_json:
    print(json.dumps(items, indent=2)); sys.exit()

if not items:
    print('(empty)'); sys.exit()

w = max(len(i['key']) for i in items)
print(f"{'KEY'.ljust(w)}  {'SIZE':>8}  MODIFIED")
print('-' * (w + 32))
for i in items:
    print(f"{i['key'].ljust(w)}  {human(i['bytes']):>8}  {i['modified'][:16].replace('T',' ')}")
print(f"\n{len(items)} object(s)   base: {base}/")
PY
}

cmd_info() {
  local key="${1:-}" json="${2:-}"
  [ -n "$key" ] || die "usage: imgcli info <key> [--json]"
  load_config
  key="$(norm_key "$key")"

  local out
  out=$(s3api head-object --bucket "$BUCKET" --key "${PREFIX}${key}" --output json 2>/dev/null) \
    || die "not found: $key"

  CDN_BASE="$CDN_BASE" KEY="$key" JSON="${json:-}" python3 - "$out" <<'PY'
import sys, json, os
d = json.loads(sys.argv[1])
key, base = os.environ['KEY'], os.environ['CDN_BASE']
md = d.get('Metadata', {})
info = {
    'key': key,
    'url': f"{base}/{key}",
    'bytes': d.get('ContentLength'),
    'content_type': d.get('ContentType'),
    'modified': str(d.get('LastModified')),
    'source_dimensions': (f"{md['width']}x{md['height']}" if 'width' in md and 'height' in md else None),
    'renditions': {
        'thumb_400':  f"{base}/rs:fill:400:400/{key}",
        'web_800':    f"{base}/rs:fit:800/{key}",
        'web_1600':   f"{base}/rs:fit:1600/{key}",
        'og_jpg':     f"{base}/rs:fill:1200:630/f:jpg/{key}",
        'original':   f"{base}/{key}",
    },
}
if os.environ['JSON'] == '--json':
    print(json.dumps(info, indent=2)); sys.exit()
print(f"key         {info['key']}")
print(f"url         {info['url']}")
print(f"size        {info['bytes']} bytes  ({info['content_type']})")
print(f"source dim  {info['source_dimensions'] or '(unknown — uploaded outside imgcli)'}")
print(f"modified    {info['modified']}")
print("\nrenditions")
for k, v in info['renditions'].items():
    print(f"  {k:<12} {v}")
PY
}

cmd_url() {
  local key="${1:-}"; shift || true
  [ -n "$key" ] || die "usage: imgcli url <key> [transform ...]  e.g. imgcli url blog/x.jpg rs:fit:800 f:jpg"
  load_config
  key="$(norm_key "$key")"
  local ops=""
  for op in "$@"; do ops="${ops}${op}/"; done
  printf '%s/%s%s\n' "$CDN_BASE" "$ops" "$key"
}

cmd_transforms() {
  cat <<'EOF'
imgproxy processing options — prepend to the key, slash-separated, any order:

  https://<cdn>/rs:fit:800/f:jpg/blog/photo.jpg
                └── options ──┘ └── key ──┘

RESIZE
  rs:fit:W:H        fit inside WxH, preserve aspect (most common)
  rs:fill:W:H       fill WxH exactly, cropping overflow
  rs:fill-down:W:H  like fill but never enlarges
  rs:force:W:H      stretch to exactly WxH, ignoring aspect
  w:400 / h:300     set one dimension only
  s:800:600         shorthand for size
  dpr:2             multiply all dimensions (retina)
  el:1              allow enlarging beyond source resolution

CROP & POSITION
  c:W:H             crop to WxH before resizing
  g:sm              smart gravity (content-aware; use with rs:fill)
  g:no|so|ea|we|ce  north/south/east/west/center
  g:fp:0.5:0.3      focus point, fractions of width/height
  pd:20             pad 20px
  ex:1              extend to requested size if source is smaller
  rot:90            rotate 90/180/270
  t:10              trim border, tolerance 10

FORMAT & QUALITY
  f:jpg|png|webp|avif   force output format
  q:80                  quality 1-100
  mb:100000             cap output at ~N bytes (auto-lowers quality)

EFFECTS
  bl:5              blur, sigma 5
  sh:0.5            sharpen
  bg:255:255:255    background colour for transparency/padding

OTHER
  cb:v2             cache buster — changes the URL, forces a fresh render
  fn:name           filename in Content-Disposition
  att:1             serve as attachment (download)
  sm:1              strip metadata (already the server default)

NOT AVAILABLE — verified 404 against this deployment
  px:N              pixelate — imgproxy Pro only
  pr:name           presets — none configured server-side
  wm:*              watermark — accepted but a no-op, no watermark configured

NOTES
  - Omit all options to get the untouched original.
  - Format is auto-negotiated (AVIF/WebP) from the Accept header unless f: is set.
  - Prefer f:jpg over the @jpg extension form: @jpg is NOT edge-cached by
    Cloudflare (the path stops ending in a recognised extension).
  - EXIF/GPS is stripped from every rendition by default — originals in the
    bucket keep theirs, but nothing served through the CDN exposes location.
  - rs:fit:N bounds the LONGEST side to N; it does not force width.
EOF
}

cmd_private() {
  local file="" expires="" copy=0 json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --expires) expires="$2"; shift 2 ;;
      --copy) copy=1; shift ;;
      --json) json=1; shift ;;
      -*) die "unknown flag: $1" ;;
      *) if [ -z "$file" ]; then file="$1"; else die "unexpected argument: $1"; fi; shift ;;
    esac
  done
  [ -n "$file" ] || die "usage: imgcli private <file> [--expires <dur>] [--copy] [--json]"
  [ -f "$file" ] || die "no such file: $file"
  parse_expires "$expires"

  load_private_config
  private_put "$file"

  if [ "$json" = 1 ]; then
    printf '{"key":"%s","url":"%s","expiresAt":"%s","bytes":%s}\n' \
      "$P_KEY" "$P_URL" "$P_EXPIRES_AT" "$P_BYTES"
  else
    printf 'key         %s\n' "$P_KEY"
    printf 'expires     %s\n' "$P_EXPIRES_AT"
    printf '\n%s\n' "$P_URL"
  fi

  [ "$copy" = 1 ] && printf '%s' "$P_URL" | pbcopy && printf '  (copied)\n'
  return 0
}

cmd_private_url() {
  local key="" expires="" copy=0 json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --expires) expires="$2"; shift 2 ;;
      --copy) copy=1; shift ;;
      --json) json=1; shift ;;
      -*) die "unknown flag: $1" ;;
      *) if [ -z "$key" ]; then key="$1"; else die "unexpected argument: $1"; fi; shift ;;
    esac
  done
  [ -n "$key" ] || die "usage: imgcli private-url <key> [--expires <dur>] [--copy] [--json]"
  parse_expires "$expires"

  load_private_config
  key="$(norm_private_key "$key")"
  check_key "$key"

  s3api head-object --bucket "$BUCKET" --key "${PRIVATE_PREFIX}${key}" >/dev/null 2>&1 \
    || die "not found: $key"
  presign_url "${PRIVATE_PREFIX}${key}"

  if [ "$json" = 1 ]; then
    printf '{"key":"%s","url":"%s","expiresAt":"%s"}\n' "$key" "$P_URL" "$P_EXPIRES_AT"
  else
    printf 'expires     %s\n' "$P_EXPIRES_AT"
    printf '\n%s\n' "$P_URL"
  fi

  [ "$copy" = 1 ] && printf '%s' "$P_URL" | pbcopy && printf '  (copied)\n'
  return 0
}

cmd_private_ls() {
  local dest="" json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      -*) die "unknown flag: $1" ;;
      *) dest="$1"; shift ;;
    esac
  done
  load_private_config
  dest="$(norm_private_key "${dest:-}")"

  local out
  out=$(s3api list-objects-v2 --bucket "$BUCKET" --prefix "${PRIVATE_PREFIX}${dest}" \
        --query 'Contents[].{k:Key,s:Size,m:LastModified}' --output json) \
    || die "could not list ${PRIVATE_PREFIX}${dest}"
  [ "$out" = "null" ] && out='[]'

  PREFIX="$PRIVATE_PREFIX" JSON="$json" python3 - "$out" <<'PY'
import sys, json, os
rows = json.loads(sys.argv[1]) or []
prefix = os.environ['PREFIX']
as_json = os.environ['JSON'] == '1'

def human(b):
    for u in ('B','KB','MB','GB'):
        if b < 1024: return f"{b:.0f}{u}" if u=='B' else f"{b:.1f}{u}"
        b /= 1024
    return f"{b:.1f}TB"

items = []
for r in rows:
    key = r['k'][len(prefix):] if r['k'].startswith(prefix) else r['k']
    if not key or key.endswith('/'):
        continue
    items.append({'key': key, 'bytes': r['s'], 'modified': r['m']})

if as_json:
    print(json.dumps(items, indent=2)); sys.exit()

if not items:
    print('(empty)'); sys.exit()

w = max(len(i['key']) for i in items)
print(f"{'KEY'.ljust(w)}  {'SIZE':>8}  MODIFIED")
print('-' * (w + 32))
for i in items:
    print(f"{i['key'].ljust(w)}  {human(i['bytes']):>8}  {i['modified'][:16].replace('T',' ')}")
print(f"\n{len(items)} object(s)   presign one with: imgcli private-url <key>")
PY
}

cmd_rm() {
  local key="" yes=0 json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes) yes=1; shift ;;
      --json) json=1; shift ;;
      -*) die "unknown flag: $1" ;;
      *) if [ -z "$key" ]; then key="$1"; else die "unexpected argument: $1"; fi; shift ;;
    esac
  done
  [ -n "$key" ] || die "usage: imgcli rm <key> [--yes] [--json]"

  # Config first (it supplies PREFIX), then the admin key — resolved before the
  # prompt so a headless caller fails immediately instead of after confirming.
  load_config
  load_admin_key
  key="$(norm_key "$key")"
  check_key "$key"

  if [ "$yes" != 1 ]; then
    printf 'Delete %s%s from B2? This is irreversible. [y/N] ' "$PREFIX" "$key"
    read -r confirm || confirm=""
    case "$confirm" in
      y|Y|yes|Yes) : ;;
      *)
        [ "$json" = 1 ] && printf '{"deleted":false,"aborted":true}\n' || printf 'aborted\n'
        return 1
        ;;
    esac
  fi

  s3api delete-object --bucket "$BUCKET" --key "${PREFIX}${key}" >/dev/null \
    || die "delete failed: $key"

  if [ "$json" = 1 ]; then
    printf '{"deleted":true,"key":"%s"}\n' "$key"
  else
    printf 'deleted  %s%s\n' "$PREFIX" "$key"
  fi
}

# --- cutout & icons (image-gateway) ------------------------------------------
# Both are thin clients: the gateway owns background removal (Replicate,
# recraft by default) and the whole icon-set build, so the studio and agents
# get byte-identical results.

image_mime() {
  case "${1##*.}" in
    png|PNG) printf 'image/png' ;;
    jpg|jpeg|JPG|JPEG) printf 'image/jpeg' ;;
    webp|WEBP) printf 'image/webp' ;;
    *) die "image must be png, jpeg or webp: $1" ;;
  esac
}

# Not `local`-scoped: the EXIT trap runs after the caller's scope is gone.
gen_session() {
  GEN_TMP="$(mktemp -d)"
  trap 'rm -rf "$GEN_TMP"' EXIT
  load_gen_config
  ( umask 077; printf 'Authorization: Bearer %s\n' "$GEN_SECRET" >"$GEN_TMP/hdr" )
}

cutout_model_id() {
  case "$1" in
    ''|recraft) printf 'recraft-ai/recraft-remove-background' ;;
    bria) printf 'bria/remove-background' ;;
    *) die "unknown cutout model: $1 (must be recraft or bria)" ;;
  esac
}

cmd_cutout() {
  local src="" model="" out="" json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --model) model="$2"; shift 2 ;;
      --out) out="$2"; shift 2 ;;
      --json) json=1; shift ;;
      -*) die "unknown flag: $1" ;;
      *) if [ -z "$src" ]; then src="$1"; else die "unexpected argument: $1"; fi; shift ;;
    esac
  done
  [ -n "$src" ] || die "usage: imgcli cutout <file> [--model recraft|bria] [--out <file.png>] [--json]"
  [ -f "$src" ] || die "no such file: $src"
  local mime model_id
  mime="$(image_mime "$src")"
  model_id="$(cutout_model_id "$model")"
  [ -n "$out" ] || out="${src%.*}-cutout.png"

  gen_session
  local res="$GEN_TMP/cutout-res.json"
  gen_request /cutout "$res" -F "image=@${src};type=${mime}" --form-string "model=${model_id}"
  OUT="$out" JSON="$json" python3 -c '
import base64, json, os, sys
d = json.load(open(sys.argv[1]))
open(os.environ["OUT"], "wb").write(base64.b64decode(d["image"]["b64_json"]))
cost = d.get("cost", {}).get("usd")
if os.environ["JSON"] == "1":
    print(json.dumps({"id": d["id"], "model": d["model"], "file": os.path.abspath(os.environ["OUT"]),
                      "width": d["width"], "height": d["height"], "cost_usd": cost, "latency_ms": d["latency_ms"]}))
else:
    print("cutout     %s  %sx%s  $%s  %sms\n  %s" % (d["model"], d["width"], d["height"], cost, d["latency_ms"], os.path.abspath(os.environ["OUT"])))
' "$res"
}

ICON_PROMPT_SUFFIX="App icon artwork: one simple, bold, centered subject with a clear silhouette that still reads at 16 pixels; no text, no frame, no drop shadow; transparent background."

cmd_icon() {
  local prompt="" from="" quality="medium" bg="#ffffff" cutout="auto" out="" json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) from="$2"; shift 2 ;;
      --quality) quality="$2"; shift 2 ;;
      --bg) bg="$2"; shift 2 ;;
      --cutout) cutout="$2"; shift 2 ;;
      --out) out="$2"; shift 2 ;;
      --json) json=1; shift ;;
      -*) die "unknown flag: $1" ;;
      *) if [ -z "$prompt" ]; then prompt="$1"; else die "unexpected argument: $1"; fi; shift ;;
    esac
  done
  { [ -n "$prompt" ] && [ -z "$from" ]; } || { [ -z "$prompt" ] && [ -n "$from" ]; } \
    || die "usage: imgcli icon \"<prompt>\" | --from <file>  [--quality low|medium|high|xhigh|max] [--bg #rrggbb] [--cutout auto|always|never] [--out <dir>] [--json]"
  [ -z "$from" ] || [ -f "$from" ] || die "no such file: $from"
  case "$quality" in low|medium|high|xhigh|max) : ;; *) die "unknown quality: $quality" ;; esac
  case "$bg" in \#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) : ;; *) die "--bg must be #rrggbb: $bg" ;; esac
  case "$cutout" in auto|always|never) : ;; *) die "--cutout must be auto, always or never: $cutout" ;; esac
  [ -n "$out" ] || out="${GEN_DIR}/icons-$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$out"

  gen_session
  local src="$from" gen_cost=""
  if [ -n "$prompt" ]; then
    # Square + native alpha straight from the model, so `cutout: auto` skips
    # the Replicate step for a fresh generation.
    local req="$GEN_TMP/icon-gen-req.json" res="$GEN_TMP/icon-gen-res.json"
    PROMPT="$prompt $ICON_PROMPT_SUFFIX" QUALITY="$quality" python3 -c '
import json, os, sys
json.dump({"prompt": os.environ["PROMPT"], "size": "1024x1024", "quality": os.environ["QUALITY"],
           "background": "transparent", "output_format": "png"}, open(sys.argv[1], "w"))
' "$req"
    gen_request /generate "$res" -H "Content-Type: application/json" --data-binary "@$req"
    src="$out/source.png"
    gen_cost="$(SRC="$src" python3 -c '
import base64, json, os, sys
d = json.load(open(sys.argv[1]))
open(os.environ["SRC"], "wb").write(base64.b64decode(d["images"][0]["b64_json"]))
print(d.get("cost", {}).get("usd") or 0)
' "$res")"
  fi

  local mime res="$GEN_TMP/icons-res.json"
  mime="$(image_mime "$src")"
  gen_request /icons "$res" -F "image=@${src};type=${mime}" --form-string "background=${bg}" --form-string "cutout=${cutout}"
  OUT="$out" JSON="$json" GEN_COST="$gen_cost" SRC="$src" python3 -c '
import base64, json, os, sys
d = json.load(open(sys.argv[1]))
out = os.environ["OUT"]
files = []
for f in d["files"]:
    path = os.path.join(out, f["name"])
    open(path, "wb").write(base64.b64decode(f["b64"]))
    files.append({"name": f["name"], "file": path, "width": f["width"], "height": f["height"]})
open(os.path.join(out, "head.html"), "w").write(d["html"].rstrip() + "\n")
with open(os.path.join(out, "manifest.webmanifest"), "w") as m:
    json.dump(d["manifest"], m, indent=2); m.write("\n")
cost = (d.get("cost", {}).get("usd") or 0) + float(os.environ["GEN_COST"] or 0)
steps = d.get("steps", [])
summary = {"id": d["id"], "dir": out, "source": os.path.abspath(os.environ["SRC"]),
           "steps": steps, "svg_skipped_reason": d.get("svg_skipped_reason"),
           "cost_usd": round(cost, 4), "files": files,
           "html": os.path.join(out, "head.html"), "manifest": os.path.join(out, "manifest.webmanifest")}
if os.environ["JSON"] == "1":
    print(json.dumps(summary))
else:
    ran = ", ".join("%s (%s)" % (st["step"], st["model"].split("/")[-1]) for st in steps) or "none"
    print("icons      %d files  steps: %s  $%.4f\n  %s" % (len(files), ran, cost, out))
    for f in files:
        print("  %-22s %sx%s" % (f["name"], f["width"], f["height"]))
    if d.get("svg_skipped_reason"):
        print("  no favicon.svg: " + d["svg_skipped_reason"])
' "$res"
}

usage() {
  cat <<'EOT'
imgcli — generate images, publish them to the CDN, share them privately

  imgcli gen     "<prompt>" [--size WxH|auto] [--n 1-10] [--quality low|medium|high|xhigh|max|auto]
                 [--background transparent|opaque|auto] [--edit <file>] [--enhance] [--public [--prefix gen/]] [--private [--expires <dur>]]
                 [--copy] [--open] [--json]

  imgcli cutout  <file> [--model recraft|bria] [--out <file.png>] [--json]
  imgcli icon    "<prompt>" | --from <file> [--quality medium] [--bg #rrggbb] [--cutout auto|always|never]
                 [--out <dir>] [--json]

  imgcli upload  <file> [prefix/] [--name N] [--copy] [--open] [--json]
  imgcli publish <file> [prefix/] ...              (alias of upload)
  imgcli sync    <dir> <prefix/> [--json]          (bulk upload of a folder)
  imgcli ls      [prefix/] [--json]
  imgcli info    <key> [--json]
  imgcli url     <key> [transform ...]
  imgcli transforms
  imgcli rm      <key> [--yes] [--json]            (MacBook-only)

  imgcli private     <file> [--expires <dur>] [--copy] [--json]
  imgcli private-url <key> [--expires <dur>] [--copy] [--json]
  imgcli private-ls  [prefix/] [--json]

TWO LANES, ONE BUCKET
  img/      public CDN (imgproxy, unsigned URLs) — anything here is public; for
            gen/ and misc/ an unguessable random name is the access control.
  private/  never reachable through imgproxy — shared only via time-limited
            presigned URLs. Keys are given without the private/ prefix.

PREFIXES (upload, sync, gen --public)
  fuji/   curated camera exports   — readable names kept
  blog/   article images           — readable names kept
  gen/    generated / ad-hoc       — random names auto-assigned  (gen default)
  misc/   everything else          — random names auto-assigned  (upload default)

Keys are given without the bucket's img/ prefix; `blog/x.jpg` and
`img/blog/x.jpg` both work. upload skips (never overwrites) a key that exists.
Sources: jpg, jpeg, png, webp, avif, heic, raf; at most 50 MB and 100 MP.

PRIVATE
  private  puts the file at private/<yyyy>/<mm>/<random>.<ext> and prints a
           presigned GET URL. --expires takes 90s, 30m, 12h, 7d, 1w or plain
           seconds; default and maximum 7d (the SigV4 limit).
  private-url  re-presigns an existing object. private-ls lists private/.

GENERATION
  gen      generates on the image-gateway (VPS, gpt-image-2.5) and writes the
           PNGs to ~/Pictures/imgcli/. --public uploads each one to the CDN
           (same path as `upload`) and prints the URL + markdown; --private
           puts it under private/ and prints a presigned URL (not combinable).
           --edit <file> sends the prompt as an edit of that reference image;
           --enhance runs the brief through the gateway's Plan step first
           (playbook prompt + derived size/quality/n, explicit flags win).
           Quality is the cost lever: low ~$0.006, high ~$0.053, xhigh ~$0.094,
           max ~$0.21 per 1024x1024 image.

CUTOUT & ICONS
  cutout   removes the background via the gateway (Replicate; recraft $0.01
           default, bria $0.018) and writes <file>-cutout.png next to the source.
  icon     builds a complete favicon / app-icon set into ~/Pictures/imgcli/icons-<stamp>/:
           favicon.ico (16/32/48), favicon.svg (vectorized, skipped for gradient-heavy
           art), icon-192/512.png, icon-mask.png (maskable),
           apple-touch-icon.png (180, opaque on --bg), icon-1024.png (opaque,
           Xcode/App Store), AppIcon.icns (macOS), head.html, manifest.webmanifest.
           From a prompt it generates 1024x1024 with native alpha (no cutout
           needed); --from <file> takes existing art and cuts it out when it has
           no transparency (--cutout auto); sources under 512px are upscaled first
           (real-esrgan, $0.002). Vectorizing adds $0.01. Typical total from a
           prompt at medium: ~$0.023.

JSON
  cutout   {"id","model","file","width","height","cost_usd","latency_ms"}
  icon     {"id","dir","source","steps":[{"step","model","cost_usd","latency_ms"}],"svg_skipped_reason",
            "cost_usd","files":[{"name","file","width","height"}],"html","manifest"}
  gen      {"id","model","size","quality","cost_usd","latency_ms","public","private",
            "images":[{"file","id"}],"plan"?}; --public adds key,cdnUrl,markdown
            per image, --private adds key,url,expiresAt
  upload   {"uploaded","key","url","dimensions","bytes"}   (skipped: uploaded:false + reason)
  private  {"key","url","expiresAt","bytes"}

SECRETS (1Password via secrets-run; never bare op)
  op://common/b2-images-write    img/ write, no delete       upload, sync, ls, info, url
  op://common/b2-images-private  private/ read/write, no delete   private, private-url, private-ls
  op://common/b2-images-admin    img/ incl. delete           rm only — MacBook-only by design,
                                 deliberately not in the mini's headless cache
  op://common/backblaze-s3       bucket coordinates          every B2 command
  op://vps/image-gateway         gateway BASE_URL/API_SECRET gen
On the headless mini the write/private/gateway refs must be seeded first
(dotfiles-private/headless.refs + `make secrets-seed`).
EOT
}

case "${1:-}" in
  upload|publish) shift; cmd_upload "$@" ;;
  sync)           shift; cmd_sync "$@" ;;
  ls)             shift; cmd_ls "$@" ;;
  info)           shift; cmd_info "$@" ;;
  url)            shift; cmd_url "$@" ;;
  transforms)     cmd_transforms ;;
  rm)             shift; cmd_rm "$@" ;;
  private)        shift; cmd_private "$@" ;;
  private-url)    shift; cmd_private_url "$@" ;;
  private-ls)     shift; cmd_private_ls "$@" ;;
  gen)            shift; cmd_gen "$@" ;;
  cutout)         shift; cmd_cutout "$@" ;;
  icon|icons)     shift; cmd_icon "$@" ;;
  ""|-h|--help|help) usage ;;
  share|library|link) die "'$1' was removed with image-share (2026-10) — use 'private', 'private-url' or 'private-ls'" ;;
  *) die "unknown command: $1 (try --help)" ;;
esac
