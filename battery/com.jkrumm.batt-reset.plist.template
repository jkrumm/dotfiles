<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jkrumm.batt-reset</string>
  <!-- Daily reset of the battery charge cap to the 80% default. Any temporary
       boost (e.g. 100% via Raycast) auto-expires the next morning. batt runs
       with --always-allow-non-root-access, so this user agent needs no root. -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/opt/batt/bin/batt</string>
    <string>limit</string>
    <string>80</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <!-- Don't fire on load — only at the scheduled time, so installing/reloading
       the agent never clobbers an intentional boost. -->
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/tmp/batt-reset.log</string>
  <key>StandardErrorPath</key><string>/tmp/batt-reset.log</string>
</dict>
</plist>
