<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jkrumm.collie</string>
  <!-- Supervises the Collie bridge (herdr plugin herdr.collie) as a real
       LaunchAgent. collie-ctl.sh writes a systemd unit on Linux and falls back
       to a bare `nohup` on macOS — that process dies on reboot, which is the
       whole gap this file closes. Same always-on shape as the herdr brew
       service: RunAtLoad + KeepAlive. -->
  <!-- The .env MUST be sourced here. The bridge reads process.env only (see
       bridge/config.ts) and never parses .env itself — on Linux systemd supplies
       it with `EnvironmentFile=-`, and launchd has no equivalent. Exec'ing bun
       directly therefore starts a bridge with COLLIE_PUBLIC_HOSTS,
       COLLIE_MULTI_SESSION and COLLIE_SKIP_SERVE all UNSET: every hardening
       setting silently off, the DNS-rebinding guard included, while the process
       looks perfectly healthy. Caught by asserting a spoofed Host header still
       returns 403 after the switch to launchd — it had gone back to 200.
       `set -a` exports what the file defines; the `[ -f ]` guard mirrors
       systemd's leading `-` (optional file). -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>set -a; [ -f "__CONFIG_DIR__/.env" ] &amp;&amp; . "__CONFIG_DIR__/.env"; set +a; exec "__BUN__" run "__PLUGIN_ROOT__/bridge/index.ts"</string>
  </array>
  <key>WorkingDirectory</key><string>__PLUGIN_ROOT__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- PATH is load-bearing, not cosmetic: a herdr-server-spawned command does
       NOT inherit Homebrew's PATH (invoking the plugin action directly via
       `herdr plugin action invoke start --plugin herdr.collie` fails with
       `error: bun not found`), and launchd starts this agent with no shell
       profile at all. Same class of failure as the mosh-server/~/.zshenv trap. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HERDR_SOCKET_PATH</key><string>__SOCKET__</string>
    <key>COLLIE_PORT</key><string>8787</string>
    <key>HERDR_PLUGIN_CONFIG_DIR</key><string>__CONFIG_DIR__</string>
  </dict>
  <key>StandardOutPath</key><string>__CONFIG_DIR__/collie.log</string>
  <key>StandardErrorPath</key><string>__CONFIG_DIR__/collie.log</string>
</dict>
</plist>
